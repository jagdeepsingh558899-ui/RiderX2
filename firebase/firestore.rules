rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // COMMON FUNCTIONS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function isAdmin() {
      return signedIn()
        && (
          userDoc().data.role == "admin"
          || userDoc().data.role == "administrator"
          || userDoc().data.isAdmin == true
        );
    }

    function isRider() {
      return signedIn()
        && userDoc().data.role == "rider";
    }

    function isCustomer() {
      return signedIn()
        && userDoc().data.role == "customer";
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // RIDERS
    // =========================================================

    match /riders/{riderId} {

      allow read: if signedIn()
        && (
          request.auth.uid == riderId
          || isAdmin()
        );

      allow create: if signedIn()
        && request.auth.uid == riderId;

      allow update: if signedIn()
        && (
          request.auth.uid == riderId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // CUSTOMERS
    // =========================================================

    match /customers/{customerId} {

      allow read: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );

      allow create: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );

      allow update: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // RIDES
    // =========================================================

    match /rides/{rideId} {

      // -------------------------------------------------------
      // CUSTOMER CREATE
      // -------------------------------------------------------

      allow create: if signedIn()
        && (
          (
            isCustomer()
            && request.resource.data.customerId ==
               request.auth.uid
          )
          ||
          isAdmin()
        );


      // -------------------------------------------------------
      // RIDE READ
      // -------------------------------------------------------

      allow read: if signedIn()
        && (

          // Customer's own rides
          resource.data.customerId ==
            request.auth.uid

          ||

          // Rider's assigned rides
          resource.data.riderId ==
            request.auth.uid

          ||

          // Online/approved riders can see available requests
          (
            isRider()
            &&
            (
              resource.data.status == "searching"
              ||
              resource.data.status == "REQUESTED"
            )
          )

          ||

          // Admin
          isAdmin()
        );


      // -------------------------------------------------------
      // RIDE UPDATE
      // -------------------------------------------------------

      allow update: if signedIn()
        && (

          // Admin
          isAdmin()

          ||

          // Customer's own ride
          (
            isCustomer()
            &&
            resource.data.customerId ==
              request.auth.uid
          )

          ||

          // Rider's already assigned ride
          (
            isRider()
            &&
            resource.data.riderId ==
              request.auth.uid
          )

          ||

          // Rider accepts an available ride
          (
            isRider()
            &&
            (
              resource.data.status == "searching"
              ||
              resource.data.status == "REQUESTED"
            )
            &&
            request.resource.data.riderId ==
              request.auth.uid
            &&
            (
              request.resource.data.status == "ACCEPTED"
              ||
              request.resource.data.status == "accepted"
            )
          )
        );


      // -------------------------------------------------------
      // RIDE DELETE
      // -------------------------------------------------------

      allow delete: if isAdmin();
    }


    // =========================================================
    // WALLETS
    // =========================================================

    match /wallets/{walletId} {

      allow read: if signedIn()
        && (
          request.auth.uid == walletId
          || isAdmin()
        );

      allow create: if signedIn()
        && (
          request.auth.uid == walletId
          || isAdmin()
        );

      allow update: if signedIn()
        && (
          request.auth.uid == walletId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // SUPPORT
    // =========================================================

    match /support/{supportId} {

      allow read: if signedIn();

      allow create: if signedIn();

      allow update: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
            request.auth.uid
        );

      allow delete: if isAdmin();
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{settingId} {

      // Fare and other app settings can be read
      // by authenticated users.
      allow read: if signedIn();

      // Only admin can change settings.
      allow write: if isAdmin();
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {

      allow read: if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          ||
          isAdmin()
        );

      allow create: if signedIn();

      allow update: if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          ||
          isAdmin()
        );

      allow delete: if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          ||
          isAdmin()
        );
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }

  }
}
