rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================================
       RIDERX FIRESTORE SECURITY RULES
       =====================================================

       AUTHENTICATION:
       - Firebase Authentication is the source of truth.

       DATABASE:
       - Cloud Firestore.

       FILE STORAGE:
       - Backblaze B2 only.
       - Firebase Storage is NOT used.

       SECURITY PRINCIPLES:
       - No client can create an admin account.
       - Users cannot change their own role.
       - Users cannot self-approve as riders.
       - Financial fields are protected.
       - Ride ownership cannot be transferred.
       - Ride acceptance requires an approved active rider.
       - Chat messages are immutable for clients.
       - Unknown collections are denied by default.
       ===================================================== */


    /* =====================================================
       COMMON HELPERS
       ===================================================== */

    function signedIn() {
      return request.auth != null;
    }


    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }


    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }


    function userExists(uid) {
      return exists(userPath(uid));
    }


    function userData(uid) {
      return get(userPath(uid)).data;
    }


    function currentUserData() {
      return userData(request.auth.uid);
    }


    function isAdmin() {
      return signedIn()
        && userExists(request.auth.uid)
        && (
          currentUserData().get("role", "") == "admin"
          || currentUserData().get("userRole", "") == "admin"
          || currentUserData().get("accountType", "") == "admin"
          || currentUserData().get("isAdmin", false) == true
        );
    }


    function activeAccount() {
      return signedIn()
        && userExists(request.auth.uid)
        && currentUserData().get("disabled", false) != true
        && currentUserData().get("blocked", false) != true
        && currentUserData().get("status", "") != "disabled"
        && currentUserData().get("status", "") != "blocked"
        && currentUserData().get("status", "") != "suspended";
    }


    function isCustomer() {
      return signedIn()
        && userExists(request.auth.uid)
        && !isAdmin()
        && (
          currentUserData().get("role", "") == "customer"
          || currentUserData().get("userRole", "") == "customer"
          || currentUserData().get("accountType", "") == "customer"
          || currentUserData().get("role", "") == "user"
        );
    }


    function isRider() {
      return signedIn()
        && userExists(request.auth.uid)
        && !isAdmin()
        && (
          currentUserData().get("role", "") == "rider"
          || currentUserData().get("userRole", "") == "rider"
          || currentUserData().get("accountType", "") == "rider"
          || currentUserData().get("userType", "") == "rider"
        );
    }


    /* =====================================================
       RIDER HELPERS
       ===================================================== */

    function riderPath(uid) {
      return /databases/$(database)/documents/riders/$(uid);
    }


    function riderExists(uid) {
      return exists(riderPath(uid));
    }


    function riderData(uid) {
      return get(riderPath(uid)).data;
    }


    function riderApproved() {
      return signedIn()
        && isRider()
        && riderExists(request.auth.uid)
        && (
          riderData(request.auth.uid).get("adminApproved", false) == true
          || riderData(request.auth.uid).get("approved", false) == true
          || riderData(request.auth.uid).get("isApproved", false) == true
          || riderData(request.auth.uid).get("approvalStatus", "") == "approved"
          || riderData(request.auth.uid).get("status", "") == "approved"
          || riderData(request.auth.uid).get("riderStatus", "") == "approved"
        );
    }


    function canReceiveRideRequests() {
      return riderApproved()
        && activeAccount();
    }


    /* =====================================================
       GENERIC PARTICIPANT HELPERS
       ===================================================== */

    function isRideParticipant(data) {
      return signedIn()
        && (
          data.get("customerId", "") == request.auth.uid
          || data.get("userId", "") == request.auth.uid
          || data.get("riderId", "") == request.auth.uid
          || data.get("driverId", "") == request.auth.uid
        );
    }


    function isBookingParticipant(data) {
      return signedIn()
        && (
          data.get("customerId", "") == request.auth.uid
          || data.get("userId", "") == request.auth.uid
          || data.get("riderId", "") == request.auth.uid
          || data.get("driverId", "") == request.auth.uid
        );
    }


    /* =====================================================
       RIDE STATUS HELPERS
       ===================================================== */

    function isSearchingStatus(status) {
      return status == "REQUESTED"
        || status == "requested"
        || status == "SEARCHING"
        || status == "searching"
        || status == "PENDING"
        || status == "pending";
    }


    function isAcceptedStatus(status) {
      return status == "ACCEPTED"
        || status == "accepted";
    }


    function isArrivingStatus(status) {
      return status == "ARRIVING"
        || status == "arriving";
    }


    function isArrivedStatus(status) {
      return status == "ARRIVED"
        || status == "arrived";
    }


    function isStartedStatus(status) {
      return status == "STARTED"
        || status == "started"
        || status == "IN_PROGRESS"
        || status == "in_progress"
        || status == "ONGOING"
        || status == "ongoing";
    }


    function isCompletedStatus(status) {
      return status == "COMPLETED"
        || status == "completed"
        || status == "FINISHED"
        || status == "finished";
    }


    function isCancelledStatus(status) {
      return status == "CANCELLED"
        || status == "cancelled"
        || status == "CANCELED"
        || status == "canceled";
    }


    function isActiveRideStatus(status) {
      return isAcceptedStatus(status)
        || isArrivingStatus(status)
        || isArrivedStatus(status)
        || isStartedStatus(status);
    }


    /* =====================================================
       USER OWNERSHIP
       ===================================================== */

    function sameRideOwnership(before, after) {
      return after.get("customerId", "")
          == before.get("customerId", "")
        && after.get("userId", "")
          == before.get("userId", "")
        && after.get("riderId", "")
          == before.get("riderId", "")
        && after.get("driverId", "")
          == before.get("driverId", "");
    }


    /* =====================================================
       USERS
       ===================================================== */

    match /users/{uid} {

      allow read: if
        isOwner(uid)
        || isAdmin();


      /*
       * A client can create only their own non-admin
       * customer/rider profile.
       */
      allow create: if
        isOwner(uid)
        && !(
          request.resource.data.get("role", "") == "admin"
          || request.resource.data.get("userRole", "") == "admin"
          || request.resource.data.get("accountType", "") == "admin"
          || request.resource.data.get("isAdmin", false) == true
        )
        && (
          request.resource.data.get("role", "") == "customer"
          || request.resource.data.get("role", "") == "rider"
          || request.resource.data.get("userRole", "") == "customer"
          || request.resource.data.get("userRole", "") == "rider"
          || request.resource.data.get("accountType", "") == "customer"
          || request.resource.data.get("accountType", "") == "rider"
        );


      /*
       * Admin may update user documents.
       *
       * Normal users may update only profile/UI fields.
       * Authentication/security/financial/admin fields remain
       * protected.
       */
      allow update: if
        isAdmin()

        ||

        (
          isOwner(uid)
          && activeAccount()

          && request.resource.data.get("role", "")
             == resource.data.get("role", "")

          && request.resource.data.get("userRole", "")
             == resource.data.get("userRole", "")

          && request.resource.data.get("accountType", "")
             == resource.data.get("accountType", "")

          && request.resource.data.get("isAdmin", false)
             == resource.data.get("isAdmin", false)

          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "name",
               "fullName",
               "displayName",
               "firstName",
               "lastName",
               "phone",
               "mobile",
               "phoneNumber",
               "photoURL",
               "profileImage",
               "city",
               "address",
               "language",
               "notificationEnabled",
               "notificationToken",
               "notificationUpdatedAt",
               "fcmToken",
               "pushToken",
               "updatedAt",
               "lastSeenAt"
             ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       RIDERS
       ===================================================== */

    match /riders/{uid} {

      allow read: if
        isAdmin()
        || isOwner(uid)
        || (
          signedIn()
          && isCustomer()
          && activeAccount()
        );


      /*
       * Rider creates their own application.
       *
       * A rider can NEVER self-approve.
       */
      allow create: if
        isOwner(uid)
        && isRider()
        && activeAccount()
        && request.resource.data.get("uid", "") == uid
        && request.resource.data.get("approved", false) != true
        && request.resource.data.get("isApproved", false) != true
        && request.resource.data.get("adminApproved", false) != true
        && request.resource.data.get("approvalStatus", "") != "approved"
        && request.resource.data.get("status", "") != "approved"
        && request.resource.data.get("riderStatus", "") != "approved";


      /*
       * Admin controls approval/security state.
       *
       * Approved rider may update only operational/profile
       * information.
       */
      allow update: if
        isAdmin()

        ||

        (
          isOwner(uid)
          && activeAccount()
          && riderApproved()

          && request.resource.data.get("uid", "")
             == resource.data.get("uid", "")

          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "name",
               "fullName",
               "displayName",
               "firstName",
               "lastName",
               "phone",
               "mobile",
               "phoneNumber",
               "photoURL",
               "profileImage",
               "city",
               "address",
               "vehicle",
               "vehicleType",
               "bikeModel",
               "bikeNumber",
               "licenseNumber",
               "drivingLicense",
               "documents",
               "online",
               "isOnline",
               "currentRideId",
               "currentBookingId",
               "latitude",
               "longitude",
               "location",
               "lastLocation",
               "updatedAt",
               "lastSeenAt",
               "fcmToken",
               "pushToken",
               "language",
               "notificationEnabled"
             ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       RIDES
    ===================================================== */

    match /rides/{rideId} {

      /*
       * READ ACCESS
       *
       * Admin:
       *   all rides.
       *
       * Customer/rider/driver:
       *   only rides in which they participate.
       *
       * Approved riders:
       *   may see currently searching rides so the dispatch
       *   flow can operate.
       *
       * IMPORTANT:
       * Firestore rules are not filters. The rider query must
       * therefore be compatible with this permission.
       */
      allow read: if
        isAdmin()

        ||

        isRideParticipant(resource.data)

        ||

        (
          canReceiveRideRequests()
          && isSearchingStatus(
               resource.data.get("status", "")
             )
        );


      /*
       * CUSTOMER CREATES A SEARCHING RIDE
       */
      allow create: if
        isCustomer()
        && activeAccount()

        && request.resource.data.get("customerId", "")
           == request.auth.uid

        && isSearchingStatus(
             request.resource.data.get("status", "")
           )

        && (
          request.resource.data.get("riderId", "") == ""
          || request.resource.data.get("riderId", null) == null
        )

        && (
          request.resource.data.get("driverId", "") == ""
          || request.resource.data.get("driverId", null) == null
        );


      /*
       * CUSTOMER CANCELS THEIR OWN UNASSIGNED RIDE.
       *
       * Customer cannot modify fare, rider, driver or
       * financial ownership while cancelling.
       */
      allow update: if

        isAdmin()

        ||

        (
          isCustomer()
          && activeAccount()

          && resource.data.get("customerId", "")
             == request.auth.uid

          && (
            resource.data.get("riderId", "") == ""
            || resource.data.get("riderId", null) == null
          )

          && (
            resource.data.get("driverId", "") == ""
            || resource.data.get("driverId", null) == null
          )

          && request.resource.data.get("customerId", "")
             == resource.data.get("customerId", "")

          && request.resource.data.get("riderId", "")
             == resource.data.get("riderId", "")

          && request.resource.data.get("driverId", "")
             == resource.data.get("driverId", "")

          && isCancelledStatus(
               request.resource.data.get("status", "")
             )
        );


      /*
       * APPROVED RIDER ACCEPTS A SEARCHING RIDE.
       *
       * Ownership is assigned exactly once.
       *
       * This rule prevents another rider from taking an
       * already assigned ride.
       */
      allow update: if

        canReceiveRideRequests()

        && isSearchingStatus(
             resource.data.get("status", "")
           )

        && (
          resource.data.get("riderId", "") == ""
          || resource.data.get("riderId", null) == null
        )

        && (
          resource.data.get("driverId", "") == ""
          || resource.data.get("driverId", null) == null
        )

        && request.resource.data.get("customerId", "")
           == resource.data.get("customerId", "")

        && request.resource.data.get("riderId", "")
           == request.auth.uid

        && (
          request.resource.data.get("driverId", "")
            == resource.data.get("driverId", "")
          || request.resource.data.get("driverId", null) == null
          || request.resource.data.get("driverId", "") == ""
        )

        && isAcceptedStatus(
             request.resource.data.get("status", "")
           )

        /*
         * Acceptance may not alter financial/location
         * request data.
         */
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "riderId",
               "driverId",
               "status",
               "acceptedAt",
               "updatedAt",
               "riderName",
               "riderPhone",
               "riderPhotoURL",
               "riderVehicle",
               "riderVehicleNumber"
             ]);


      /*
       * ASSIGNED RIDER/DRIVER OPERATIONAL UPDATE.
       *
       * The rider may update the ride lifecycle, but cannot
       * transfer ownership or directly alter trusted fare/
       * payment/customer data.
       */
      allow update: if

        canReceiveRideRequests()

        && (
          resource.data.get("riderId", "") == request.auth.uid
          || resource.data.get("driverId", "") == request.auth.uid
        )

        && sameRideOwnership(
             resource.data,
             request.resource.data
           )

        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "status",
               "acceptedAt",
               "arrivedAt",
               "startedAt",
               "completedAt",
               "cancelledAt",
               "updatedAt",
               "riderLatitude",
               "riderLongitude",
               "riderLocation",
               "currentLocation",
               "lastLocation",
               "otpVerified",
               "rideOtpVerified",
               "otpVerifiedAt",
               "distance",
               "duration",
               "actualDistance",
               "actualDuration",
               "riderNote",
               "driverNote"
             ]);


      /*
       * Customer may update only cancellation-related
       * lifecycle state before assignment.
       */
      allow delete: if
        isAdmin();
    }


    /* =====================================================
       BOOKINGS
    ===================================================== */

    match /bookings/{bookingId} {

      allow read: if
        isAdmin()
        || isBookingParticipant(resource.data);


      /*
       * Customer creates their own booking.
       */
      allow create: if
        isAdmin()

        ||

        (
          isCustomer()
          && activeAccount()
          && (
            request.resource.data.get("customerId", "")
              == request.auth.uid
            || request.resource.data.get("userId", "")
              == request.auth.uid
          )
        );


      /*
       * Participant updates only operational fields.
       *
       * Ownership fields can never be transferred.
       */
      allow update: if

        isAdmin()

        ||

        (
          signedIn()
          && activeAccount()
          && isBookingParticipant(resource.data)

          && request.resource.data.get("customerId", "")
             == resource.data.get("customerId", "")

          && request.resource.data.get("userId", "")
             == resource.data.get("userId", "")

          && request.resource.data.get("riderId", "")
             == resource.data.get("riderId", "")

          && request.resource.data.get("driverId", "")
             == resource.data.get("driverId", "")

          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "status",
               "updatedAt",
               "acceptedAt",
               "arrivedAt",
               "startedAt",
               "completedAt",
               "cancelledAt",
               "riderLatitude",
               "riderLongitude",
               "riderLocation",
               "distance",
               "duration",
               "actualDistance",
               "actualDuration",
               "otpVerified",
               "rideOtpVerified",
               "otpVerifiedAt",
               "riderNote",
               "driverNote"
             ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       WALLET
    ===================================================== */

    match /wallet/{uid} {

      allow read: if
        isOwner(uid)
        || isAdmin();


      /*
       * Wallet balance is trusted financial information.
       *
       * Client applications cannot directly change it.
       */
      allow create: if
        isAdmin();

      allow update: if
        isAdmin();

      allow delete: if
        isAdmin();


      match /transactions/{transactionId} {

        allow read: if
          isOwner(uid)
          || isAdmin();


        /*
         * Financial transaction creation should come from
         * trusted backend/admin logic.
         */
        allow create: if
          isAdmin();


        allow update: if
          isAdmin();


        allow delete: if
          isAdmin();
      }
    }


    /* =====================================================
       NOTIFICATIONS
    ===================================================== */

    match /notifications/{notificationId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.get("userId", "") == request.auth.uid
            || resource.data.get("uid", "") == request.auth.uid
            || resource.data.get("customerId", "") == request.auth.uid
            || resource.data.get("riderId", "") == request.auth.uid
          )
        );


      /*
       * Notifications should be created by trusted backend
       * or admin logic.
       */
      allow create: if
        isAdmin();


      /*
       * User may change only notification-read state.
       */
      allow update: if

        isAdmin()

        ||

        (
          signedIn()

          && (
            resource.data.get("userId", "") == request.auth.uid
            || resource.data.get("uid", "") == request.auth.uid
          )

          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "read",
               "isRead",
               "seen",
               "readAt",
               "updatedAt"
             ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       SUPPORT
    ===================================================== */

    match /supports/{supportId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.get("userId", "") == request.auth.uid
            || resource.data.get("uid", "") == request.auth.uid
            || resource.data.get("customerId", "") == request.auth.uid
            || resource.data.get("riderId", "") == request.auth.uid
          )
        );


      allow create: if
        signedIn()
        && activeAccount()
        && (
          request.resource.data.get("userId", "") == request.auth.uid
          || request.resource.data.get("uid", "") == request.auth.uid
          || request.resource.data.get("customerId", "") == request.auth.uid
          || request.resource.data.get("riderId", "") == request.auth.uid
        );


      allow update: if

        isAdmin()

        ||

        (
          signedIn()
          && activeAccount()

          && (
            resource.data.get("userId", "") == request.auth.uid
            || resource.data.get("uid", "") == request.auth.uid
            || resource.data.get("customerId", "") == request.auth.uid
            || resource.data.get("riderId", "") == request.auth.uid
          )

          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "message",
               "messages",
               "attachments",
               "updatedAt"
             ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       CHATS
    ===================================================== */

    match /chats/{chatId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.get("customerId", "") == request.auth.uid
            || resource.data.get("riderId", "") == request.auth.uid
            || resource.data.get("driverId", "") == request.auth.uid
          )
        );


      allow create: if
        isAdmin()

        ||

        (
          signedIn()
          && activeAccount()
          && (
            request.resource.data.get("customerId", "") == request.auth.uid
            || request.resource.data.get("riderId", "") == request.auth.uid
            || request.resource.data.get("driverId", "") == request.auth.uid
          )
        );


      allow update: if
        isAdmin()

        ||

        (
          signedIn()
          && activeAccount()

          && (
            resource.data.get("customerId", "") == request.auth.uid
            || resource.data.get("riderId", "") == request.auth.uid
            || resource.data.get("driverId", "") == request.auth.uid
          )

          && request.resource.data.get("customerId", "")
             == resource.data.get("customerId", "")

          && request.resource.data.get("riderId", "")
             == resource.data.get("riderId", "")

          && request.resource.data.get("driverId", "")
             == resource.data.get("driverId", "")
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       CHAT MESSAGES
    ===================================================== */

    match /chats/{chatId}/messages/{messageId} {

      function chatParticipant() {

        return signedIn()
          && activeAccount()

          && exists(
            /databases/$(database)/documents/chats/$(chatId)
          )

          && (
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.get("customerId", "") == request.auth.uid

            ||

            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.get("riderId", "") == request.auth.uid

            ||

            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.get("driverId", "") == request.auth.uid
          );
      }


      allow read: if
        isAdmin()
        || chatParticipant();


      allow create: if
        isAdmin()

        ||

        (
          chatParticipant()
          && request.resource.data.get("senderId", "")
             == request.auth.uid
        );


      /*
       * Client messages are immutable.
       */
      allow update: if
        isAdmin();


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       REFERRALS
    ===================================================== */

    match /referrals/{referralId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.get("userId", "") == request.auth.uid
            || resource.data.get("referrerId", "") == request.auth.uid
            || resource.data.get("referredUserId", "") == request.auth.uid
          )
        );


      allow create: if
        signedIn()
        && activeAccount()
        && (
          request.resource.data.get("userId", "") == request.auth.uid
          || request.resource.data.get("referrerId", "") == request.auth.uid
        );


      /*
       * Referral rewards are trusted financial data.
       */
      allow update: if
        isAdmin();


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       RATINGS
    ===================================================== */

    match /ratings/{ratingId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.get("customerId", "") == request.auth.uid
            || resource.data.get("riderId", "") == request.auth.uid
          )
        );


      /*
       * Customer can create only their own rating.
       *
       * Ride/trip ownership should additionally be validated
       * by the application/backend before writing the rating.
       */
      allow create: if
        isCustomer()
        && activeAccount()
        && request.resource.data.get("customerId", "")
           == request.auth.uid;


      allow update: if

        isAdmin()

        ||

        (
          isCustomer()
          && activeAccount()
          && resource.data.get("customerId", "")
             == request.auth.uid
          && request.resource.data.get("customerId", "")
             == resource.data.get("customerId", "")
          && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly([
               "rating",
               "stars",
               "comment",
               "review",
               "updatedAt"
             ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       FARE SETTINGS
    ===================================================== */

    match /fareSettings/{documentId} {

      allow read: if
        signedIn()
        && activeAccount();


      allow write: if
        isAdmin();
    }


    /* =====================================================
       APP SETTINGS
    ===================================================== */

    match /settings/{documentId} {

      allow read: if
        signedIn()
        && activeAccount();


      allow write: if
        isAdmin();
    }


    /* =====================================================
       ADMIN
    ===================================================== */

    match /admin/{documentId} {

      allow read, write: if
        isAdmin();
    }


    /* =====================================================
       DEFAULT DENY
    =====================================================

       Every collection not explicitly defined above is
       completely inaccessible from the client.
       ===================================================== */

    match /{document=**} {

      allow read, write: if
        false;
    }

  }
}
