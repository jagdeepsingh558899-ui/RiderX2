rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // COMMON HELPERS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }


    function userExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }


    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }


    function isAdmin() {
      return signedIn()
        && userExists()
        && (
          currentUser().data.role == "admin"
          ||
          currentUser().data.isAdmin == true
        );
    }


    function isRider() {
      return signedIn()
        && userExists()
        && currentUser().data.role == "rider";
    }


    function isCustomer() {
      return signedIn()
        && userExists()
        && currentUser().data.role == "customer";
    }


    function isOwner(userId) {
      return signedIn()
        && request.auth.uid == userId;
    }


    function rideBelongsToCustomer() {
      return signedIn()
        && resource.data.customerId == request.auth.uid;
    }


    function rideBelongsToRider() {
      return signedIn()
        && resource.data.riderId == request.auth.uid;
    }


    function rideIsAvailable() {
      return resource.data.status in [
        "searching",
        "SEARCHING",
        "requested",
        "REQUESTED",
        "pending",
        "PENDING"
      ];
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );


      allow create: if signedIn()
        && request.auth.uid == userId;


      /*
       * User can update own profile.
       * Admin can update everything.
       *
       * A normal user cannot change their own role/admin flag.
       */

      allow update: if signedIn()
        && (
          isAdmin()

          ||

          (
            request.auth.uid == userId

            &&

            request.resource.data.role ==
            resource.data.role

            &&

            request.resource.data.isAdmin ==
            resource.data.isAdmin
          )
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // RIDERS
    // =========================================================

    match /riders/{riderId} {

      allow read: if signedIn()
        && (
          request.auth.uid == riderId
          || isAdmin()
        );


      allow create: if signedIn()
        && (
          request.auth.uid == riderId
          || isAdmin()
        );


      /*
       * Rider can update own profile/location/status.
       * Admin can update everything.
       */

      allow update: if signedIn()
        && (
          isAdmin()

          ||

          request.auth.uid == riderId
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // CUSTOMERS
    // =========================================================

    match /customers/{customerId} {

      allow read: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );


      allow create: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );


      allow update: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // RIDES
    // =========================================================

    match /rides/{rideId} {

      // -------------------------------------------------------
      // CUSTOMER CREATES RIDE
      // -------------------------------------------------------

      allow create: if signedIn()
        && (
          isCustomer()
          || isAdmin()
        )
        && (
          isAdmin()
          ||
          request.resource.data.customerId ==
          request.auth.uid
        );


      // -------------------------------------------------------
      // READ RIDE
      // -------------------------------------------------------

      allow read: if signedIn()
        && (
          isAdmin()

          ||

          resource.data.customerId ==
          request.auth.uid

          ||

          resource.data.riderId ==
          request.auth.uid

          ||

          (
            isRider()
            && rideIsAvailable()
            && (
              !("riderId" in resource.data)
              ||
              resource.data.riderId == null
              ||
              resource.data.riderId == ""
              ||
              resource.data.riderId == request.auth.uid
            )
          )
        );


      // -------------------------------------------------------
      // CUSTOMER UPDATE
      // -------------------------------------------------------

      /*
       * Customer may update their own ride.
       * Rider assignment fields cannot be changed by customer.
       */

      allow update: if signedIn()
        && (
          isAdmin()

          ||

          (
            isCustomer()
            &&
            resource.data.customerId ==
            request.auth.uid

            &&

            request.resource.data.customerId ==
            resource.data.customerId

            &&

            request.resource.data.riderId ==
            resource.data.riderId
          )

          ||

          (
            isRider()
            &&
            resource.data.riderId ==
            request.auth.uid
          )

          ||

          (
            isRider()
            &&
            rideIsAvailable()

            &&

            (
              !("riderId" in resource.data)
              ||
              resource.data.riderId == null
              ||
              resource.data.riderId == ""
            )

            &&

            request.resource.data.riderId ==
            request.auth.uid

            &&

            request.resource.data.customerId ==
            resource.data.customerId
          )
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if isAdmin();
    }


    // =========================================================
    // RIDER LIVE LOCATIONS
    // =========================================================

    match /riderLocations/{riderId} {

      allow read: if signedIn()
        && (
          isAdmin()

          ||

          request.auth.uid == riderId

          ||

          (
            isCustomer()
            &&
            resource.data.rideId != null
            &&
            exists(
              /databases/$(database)/documents/rides/$(resource.data.rideId)
            )
            &&
            get(
              /databases/$(database)/documents/rides/$(resource.data.rideId)
            ).data.customerId ==
            request.auth.uid
          )
        );


      allow create: if signedIn()
        && (
          isAdmin()
          ||
          request.auth.uid == riderId
        );


      allow update: if signedIn()
        && (
          isAdmin()
          ||
          request.auth.uid == riderId
        );


      allow delete: if signedIn()
        && (
          isAdmin()
          ||
          request.auth.uid == riderId
        );
    }


    // =========================================================
    // WALLETS
    // =========================================================

    match /wallets/{walletId} {

      allow read: if signedIn()
        && (
          isAdmin()
          ||
          request.auth.uid == walletId
        );


      allow create: if signedIn()
        && (
          isAdmin()
          ||
          request.auth.uid == walletId
        );


      /*
       * Normal users can update wallet documents only for
       * their own wallet.
       *
       * For production payment systems, balance changes
       * should ideally be performed by trusted backend/
       * Cloud Functions rather than directly by the client.
       */

      allow update: if signedIn()
        && (
          isAdmin()
          ||
          request.auth.uid == walletId
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // WALLET TRANSACTIONS
    // =========================================================

    match /walletTransactions/{transactionId} {

      allow read: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId == request.auth.uid
        );


      allow create: if signedIn()
        && (
          isAdmin()
          ||
          request.resource.data.userId ==
          request.auth.uid
        );


      allow update: if isAdmin();


      allow delete: if isAdmin();
    }


    // =========================================================
    // PAYMENTS
    // =========================================================

    match /payments/{paymentId} {

      allow read: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
          request.auth.uid

          ||

          resource.data.customerId ==
          request.auth.uid

          ||

          resource.data.riderId ==
          request.auth.uid
        );


      allow create: if signedIn()
        && (
          isAdmin()
          ||
          request.resource.data.userId ==
          request.auth.uid

          ||

          request.resource.data.customerId ==
          request.auth.uid
        );


      allow update: if isAdmin();


      allow delete: if isAdmin();
    }


    // =========================================================
    // SUPPORT
    // =========================================================

    match /support/{supportId} {

      allow read: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
          request.auth.uid
        );


      allow create: if signedIn()
        && (
          request.resource.data.userId ==
          request.auth.uid
          ||
          isAdmin()
        );


      allow update: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
          request.auth.uid
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{settingId} {

      allow read: if signedIn();


      allow write: if isAdmin();
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {

      allow read: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
          request.auth.uid
          ||
          resource.data.recipientId ==
          request.auth.uid
        );


      /*
       * Client-side notification creation is allowed for
       * authenticated users, but recipient must be explicit.
       */

      allow create: if signedIn()
        && (
          isAdmin()
          ||
          request.resource.data.senderId ==
          request.auth.uid
          ||
          request.resource.data.userId ==
          request.auth.uid
        );


      allow update: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
          request.auth.uid
          ||
          resource.data.recipientId ==
          request.auth.uid
        );


      allow delete: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
          request.auth.uid
          ||
          resource.data.recipientId ==
          request.auth.uid
        );
    }


    // =========================================================
    // CHATS
    // =========================================================

    match /chats/{chatId} {

      allow read: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.customerId ==
          request.auth.uid
          ||
          resource.data.riderId ==
          request.auth.uid
        );


      allow create: if signedIn()
        && (
          isAdmin()
          ||
          request.resource.data.customerId ==
          request.auth.uid
          ||
          request.resource.data.riderId ==
          request.auth.uid
        );


      allow update: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.customerId ==
          request.auth.uid
          ||
          resource.data.riderId ==
          request.auth.uid
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // CHAT MESSAGES
    // =========================================================

    match /chats/{chatId}/messages/{messageId} {

      allow read: if signedIn()
        && (
          isAdmin()

          ||

          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.customerId ==
          request.auth.uid

          ||

          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.riderId ==
          request.auth.uid
        );


      allow create: if signedIn()
        && (
          isAdmin()

          ||

          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.customerId ==
          request.auth.uid

          ||

          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.riderId ==
          request.auth.uid
        );


      allow update: if signedIn()
        && (
          isAdmin()

          ||

          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.customerId ==
          request.auth.uid

          ||

          get(
            /databases/$(database)/documents/chats/$(chatId)
          ).data.riderId ==
          request.auth.uid
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // RATINGS
    // =========================================================

    match /ratings/{ratingId} {

      allow read: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.customerId ==
          request.auth.uid
          ||
          resource.data.riderId ==
          request.auth.uid
        );


      allow create: if signedIn()
        && (
          isAdmin()
          ||
          request.resource.data.customerId ==
          request.auth.uid
        );


      allow update: if isAdmin();


      allow delete: if isAdmin();
    }


    // =========================================================
    // OFFERS
    // =========================================================

    match /offers/{offerId} {

      allow read: if signedIn();


      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // COUPONS
    // =========================================================

    match /coupons/{couponId} {

      allow read: if signedIn();


      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // PRICING
    // =========================================================

    match /pricing/{pricingId} {

      allow read: if signedIn();


      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // FARE SETTINGS
    // =========================================================

    match /fareSettings/{settingId} {

      allow read: if signedIn();


      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // SERVICE SETTINGS
    // =========================================================

    match /serviceSettings/{settingId} {

      allow read: if signedIn();


      allow create, update, delete: if isAdmin();
    }


    // =========================================================
    // REPORTS
    // =========================================================

    match /reports/{reportId} {

      allow read: if isAdmin();


      allow create: if signedIn();


      allow update, delete: if isAdmin();
    }


    // =========================================================
    // ADMIN / RIDER APPROVAL
    // =========================================================

    match /riderApprovals/{approvalId} {

      allow read: if isAdmin()
        ||
        (
          signedIn()
          &&
          resource.data.riderId ==
          request.auth.uid
        );


      allow create: if signedIn()
        &&
        (
          isAdmin()
          ||
          request.resource.data.riderId ==
          request.auth.uid
        );


      allow update, delete: if isAdmin();
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {

      allow read, write: if false;
    }

  }
}
