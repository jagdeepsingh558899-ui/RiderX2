rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* =====================================================
       RIDERX 2.0
       FIRESTORE SECURITY RULES

       SECURITY MODEL
       -----------------------------------------------------
       - Authentication is mandatory for application data.
       - Users can access only their own profile.
       - Riders cannot approve themselves.
       - Customers cannot promote themselves to riders/admins.
       - Admin access is controlled by the protected user role.
       - Ride ownership cannot be transferred by clients.
       - Financial data cannot be modified by customers/riders.
       - Chat access is limited to actual participants.
       - Notifications cannot be forged by normal users.
       - Unknown collections are denied by default.

       IMPORTANT
       -----------------------------------------------------
       Admin accounts MUST be provisioned through a trusted
       administrative process. Do not create/promote admins
       from normal client-side application code.

       These rules protect FIRESTORE only.
       Realtime Database and Storage require their own rules.
    ===================================================== */


    /* =====================================================
       COMMON HELPERS
    ===================================================== */

    function signedIn() {

      return request.auth != null;

    }


    function isOwner(uid) {

      return signedIn()
        && request.auth.uid == uid;

    }


    function userPath(uid) {

      return /databases/$(database)/documents/users/$(uid);

    }


    function userExists(uid) {

      return signedIn()
        && exists(userPath(uid));

    }


    function userDocument(uid) {

      return get(userPath(uid));

    }


    function activeAccount() {

      return signedIn()
        && userExists(request.auth.uid)
        && !(
          userDocument(request.auth.uid).data.disabled == true
          ||
          userDocument(request.auth.uid).data.blocked == true
          ||
          userDocument(request.auth.uid).data.status == "disabled"
          ||
          userDocument(request.auth.uid).data.status == "blocked"
          ||
          userDocument(request.auth.uid).data.status == "suspended"
        );

    }


    /* =====================================================
       ADMIN
    ===================================================== */

    function isAdmin() {

      return signedIn()
        && userExists(request.auth.uid)
        && (
          userDocument(request.auth.uid).data.role == "admin"
          ||
          userDocument(request.auth.uid).data.userRole == "admin"
          ||
          userDocument(request.auth.uid).data.accountType == "admin"
          ||
          userDocument(request.auth.uid).data.isAdmin == true
        );

    }


    /* =====================================================
       CUSTOMER
    ===================================================== */

    function isCustomer() {

      return signedIn()
        && userExists(request.auth.uid)
        && (
          userDocument(request.auth.uid).data.role == "customer"
          ||
          userDocument(request.auth.uid).data.userRole == "customer"
          ||
          userDocument(request.auth.uid).data.accountType == "customer"
          ||
          userDocument(request.auth.uid).data.role == "user"
        );

    }


    /* =====================================================
       RIDER
    ===================================================== */

    function isRider() {

      return signedIn()
        && userExists(request.auth.uid)
        && (
          userDocument(request.auth.uid).data.role == "rider"
          ||
          userDocument(request.auth.uid).data.userRole == "rider"
          ||
          userDocument(request.auth.uid).data.accountType == "rider"
          ||
          userDocument(request.auth.uid).data.userType == "rider"
        );

    }


    /* =====================================================
       RIDER PROFILE HELPERS
    ===================================================== */

    function riderPath(uid) {

      return /databases/$(database)/documents/riders/$(uid);

    }


    function riderProfileExists() {

      return signedIn()
        && exists(riderPath(request.auth.uid));

    }


    function riderApproved() {

      return activeAccount()
        && isRider()
        && riderProfileExists()
        && (
          get(riderPath(request.auth.uid)).data.adminApproved == true
          ||
          get(riderPath(request.auth.uid)).data.approved == true
          ||
          get(riderPath(request.auth.uid)).data.isApproved == true
          ||
          get(riderPath(request.auth.uid)).data.approvalStatus == "approved"
          ||
          get(riderPath(request.auth.uid)).data.status == "approved"
          ||
          get(riderPath(request.auth.uid)).data.riderStatus == "approved"
        );

    }


    /* =====================================================
       RIDER APPROVAL STATUS
       -----------------------------------------------------
       Used to prevent a rider from changing approval fields.
    ===================================================== */

    function approvalFieldsChanged() {

      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          "approved",
          "isApproved",
          "adminApproved",
          "approvalStatus",
          "riderStatus"
        ]);

    }


    /* =====================================================
       USERS
    ===================================================== */

    match /users/{uid} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if
        isOwner(uid)
        ||
        isAdmin();


      /* ---------------------------------------------------
         CREATE

         A normal client may create only its own customer
         or rider profile.

         Admin values are explicitly rejected.
      --------------------------------------------------- */

      allow create: if
        isOwner(uid)
        &&
        !(
          request.resource.data.role == "admin"
          ||
          request.resource.data.userRole == "admin"
          ||
          request.resource.data.accountType == "admin"
          ||
          request.resource.data.isAdmin == true
        )
        &&
        (
          request.resource.data.role == "customer"
          ||
          request.resource.data.role == "rider"
          ||
          request.resource.data.role == "user"
          ||
          request.resource.data.userRole == "customer"
          ||
          request.resource.data.userRole == "rider"
          ||
          request.resource.data.accountType == "customer"
          ||
          request.resource.data.accountType == "rider"
        );


      /* ---------------------------------------------------
         UPDATE

         Users can edit only profile/preferences.

         Role, account status, admin flags and other security
         fields cannot be changed by the account owner.
      --------------------------------------------------- */

      allow update: if

        isAdmin()

        ||

        (
          isOwner(uid)
          &&
          activeAccount()
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "name",
              "fullName",
              "displayName",
              "firstName",
              "lastName",
              "phone",
              "mobile",
              "phoneNumber",
              "email",
              "photoURL",
              "city",
              "address",
              "profileImage",
              "language",
              "notificationEnabled",
              "updatedAt"
            ])
        );


      /* ---------------------------------------------------
         DELETE
      --------------------------------------------------- */

      allow delete: if
        isAdmin();

    }


    /* =====================================================
       RIDERS
    ===================================================== */

    match /riders/{uid} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if
        isOwner(uid)
        ||
        isAdmin();


      /* ---------------------------------------------------
         CREATE

         Rider can register only as an unapproved rider.
      --------------------------------------------------- */

      allow create: if

        isOwner(uid)
        &&
        activeAccount()
        &&
        (
          request.resource.data.role == "rider"
          ||
          request.resource.data.userRole == "rider"
          ||
          request.resource.data.accountType == "rider"
          ||
          request.resource.data.userType == "rider"
          ||
          request.resource.data.riderId == uid
        )
        &&
        request.resource.data.riderId == uid
        &&
        request.resource.data.adminApproved != true
        &&
        request.resource.data.approved != true
        &&
        request.resource.data.isApproved != true
        &&
        request.resource.data.approvalStatus != "approved"
        &&
        request.resource.data.status != "approved"
        &&
        request.resource.data.riderStatus != "approved";


      /* ---------------------------------------------------
         UPDATE

         Rider may update profile and operational fields.

         Approval/security/earnings fields are locked.

         Identity fields remain tied to the authenticated
         rider.
      --------------------------------------------------- */

      allow update: if

        isAdmin()

        ||

        (
          isOwner(uid)
          &&
          activeAccount()
          &&
          isRider()
          &&
          !approvalFieldsChanged()
          &&
          request.resource.data.riderId == resource.data.riderId
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "name",
              "fullName",
              "displayName",
              "firstName",
              "lastName",
              "phone",
              "mobile",
              "phoneNumber",
              "email",
              "photoURL",
              "profileImage",
              "city",
              "address",
              "vehicle",
              "vehicleType",
              "bikeModel",
              "bikeNumber",
              "licenseNumber",
              "drivingLicense",
              "documents",
              "online",
              "isOnline",
              "currentRideId",
              "currentBookingId",
              "latitude",
              "longitude",
              "location",
              "lastLocation",
              "updatedAt",
              "lastSeenAt",
              "fcmToken",
              "pushToken",
              "language",
              "notificationEnabled"
            ])
        );


      /* ---------------------------------------------------
         DELETE
      --------------------------------------------------- */

      allow delete: if
        isAdmin();

    }


    /* =====================================================
       RIDES
    ===================================================== */

    match /rides/{rideId} {


      /* ---------------------------------------------------
         READ

         Only:
         - Admin
         - Ride customer
         - Assigned rider/driver
      --------------------------------------------------- */

      allow read: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.customerId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
            ||
            resource.data.driverId == request.auth.uid
          )
        );


      /* ---------------------------------------------------
         CREATE

         Customer creates a new pending/searching ride.

         Rider assignment MUST be empty at creation.
      --------------------------------------------------- */

      allow create: if

        activeAccount()
        &&
        isCustomer()
        &&
        request.resource.data.customerId == request.auth.uid
        &&
        (
          request.resource.data.status == "REQUESTED"
          ||
          request.resource.data.status == "requested"
          ||
          request.resource.data.status == "SEARCHING"
          ||
          request.resource.data.status == "searching"
          ||
          request.resource.data.status == "pending"
          ||
          request.resource.data.status == "PENDING"
        )
        &&
        (
          request.resource.data.riderId == null
          ||
          request.resource.data.riderId == ""
        )
        &&
        (
          request.resource.data.driverId == null
          ||
          request.resource.data.driverId == ""
        );


      /* ---------------------------------------------------
         UPDATE

         CUSTOMER:
         Can cancel only an unaccepted ride.

         RIDER:
         Can accept a pending ride OR update an already
         assigned ride.

         ADMIN:
         Full administrative control.
      --------------------------------------------------- */

      allow update: if

        /* ================================================
           ADMIN
        ================================================ */

        isAdmin()

        ||

        /* ================================================
           CUSTOMER CANCELLATION
        ================================================ */

        (
          activeAccount()
          &&
          isCustomer()
          &&
          resource.data.customerId == request.auth.uid
          &&
          (
            resource.data.riderId == null
            ||
            resource.data.riderId == ""
          )
          &&
          request.resource.data.customerId ==
            resource.data.customerId
          &&
          request.resource.data.riderId ==
            resource.data.riderId
          &&
          request.resource.data.driverId ==
            resource.data.driverId
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "cancelledAt",
              "canceledAt",
              "cancellationReason",
              "updatedAt"
            ])
          &&
          (
            request.resource.data.status == "CANCELLED"
            ||
            request.resource.data.status == "cancelled"
            ||
            request.resource.data.status == "CANCELED"
            ||
            request.resource.data.status == "canceled"
          )
        )

        ||

        /* ================================================
           RIDER ACCEPTANCE
        ================================================ */

        (
          riderApproved()
          &&
          (
            resource.data.status == "REQUESTED"
            ||
            resource.data.status == "requested"
            ||
            resource.data.status == "SEARCHING"
            ||
            resource.data.status == "searching"
            ||
            resource.data.status == "pending"
            ||
            resource.data.status == "PENDING"
          )
          &&
          (
            resource.data.riderId == null
            ||
            resource.data.riderId == ""
          )
          &&
          request.resource.data.riderId ==
            request.auth.uid
          &&
          request.resource.data.driverId ==
            request.auth.uid
          &&
          request.resource.data.customerId ==
            resource.data.customerId
          &&
          (
            request.resource.data.status == "ACCEPTED"
            ||
            request.resource.data.status == "accepted"
          )
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "riderId",
              "driverId",
              "status",
              "acceptedAt",
              "updatedAt",
              "riderName",
              "driverName",
              "riderPhone",
              "driverPhone"
            ])
        )

        ||

        /* ================================================
           ASSIGNED RIDER RIDE OPERATIONS
        ================================================ */

        (
          riderApproved()
          &&
          (
            resource.data.riderId == request.auth.uid
            ||
            resource.data.driverId == request.auth.uid
          )
          &&
          request.resource.data.customerId ==
            resource.data.customerId
          &&
          request.resource.data.riderId ==
            resource.data.riderId
          &&
          request.resource.data.driverId ==
            resource.data.driverId
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "updatedAt",
              "acceptedAt",
              "arrivedAt",
              "startedAt",
              "completedAt",
              "cancelledAt",
              "canceledAt",
              "riderLatitude",
              "riderLongitude",
              "riderLocation",
              "latitude",
              "longitude",
              "location",
              "currentLocation",
              "lastLocation",
              "eta",
              "otpVerified",
              "pickupOtpVerified",
              "rideOtpVerified",
              "navigationStatus",
              "arrivalStatus",
              "tripStarted",
              "tripCompleted",
              "riderOnline",
              "lastSeenAt"
            ])
        );


      /* ---------------------------------------------------
         DELETE
      --------------------------------------------------- */

      allow delete: if
        isAdmin();

    }


    /* =====================================================
       BOOKINGS
    ===================================================== */

    match /bookings/{bookingId} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.customerId == request.auth.uid
            ||
            resource.data.userId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
            ||
            resource.data.driverId == request.auth.uid
          )
        );


      /* ---------------------------------------------------
         CREATE

         Customer creates own booking.

         Admin may create administrative bookings.
      --------------------------------------------------- */

      allow create: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          isCustomer()
          &&
          (
            request.resource.data.customerId ==
              request.auth.uid
            ||
            request.resource.data.userId ==
              request.auth.uid
          )
        );


      /* ---------------------------------------------------
         UPDATE

         Prevent customer/rider from changing ownership,
         fare authority, payment totals or assigned identity.

         Normal participants can only modify ride lifecycle,
         location and communication state.
      --------------------------------------------------- */

      allow update: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.customerId == request.auth.uid
            ||
            resource.data.userId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
            ||
            resource.data.driverId == request.auth.uid
          )
          &&
          request.resource.data.customerId ==
            resource.data.customerId
          &&
          request.resource.data.userId ==
            resource.data.userId
          &&
          request.resource.data.riderId ==
            resource.data.riderId
          &&
          request.resource.data.driverId ==
            resource.data.driverId
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "updatedAt",
              "acceptedAt",
              "arrivedAt",
              "startedAt",
              "completedAt",
              "cancelledAt",
              "canceledAt",
              "riderLatitude",
              "riderLongitude",
              "riderLocation",
              "latitude",
              "longitude",
              "location",
              "currentLocation",
              "lastLocation",
              "eta",
              "otpVerified",
              "pickupOtpVerified",
              "rideOtpVerified",
              "tripStarted",
              "tripCompleted",
              "navigationStatus",
              "arrivalStatus",
              "riderOnline",
              "lastSeenAt",
              "chatEnabled",
              "customerMessage",
              "riderMessage"
            ])
        );


      /* ---------------------------------------------------
         DELETE
      --------------------------------------------------- */

      allow delete: if
        isAdmin();

    }


    /* =====================================================
       WALLET
       ===================================================== */

    match /wallet/{uid} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if

        isOwner(uid)
        ||
        isAdmin();


      /* ---------------------------------------------------
         FINANCIAL WRITE

         Client applications cannot directly change:
         - balance
         - earnings
         - commission
         - withdrawals
         - credits
         - debits

         Trusted backend/admin must perform these changes.
      --------------------------------------------------- */

      allow create: if
        isAdmin();


      allow update: if
        isAdmin();


      allow delete: if
        isAdmin();


      /* ---------------------------------------------------
         WALLET TRANSACTIONS
      --------------------------------------------------- */

      match /transactions/{transactionId} {

        allow read: if

          isOwner(uid)
          ||
          isAdmin();


        allow create: if
          isAdmin();


        allow update: if
          isAdmin();


        allow delete: if
          isAdmin();

      }

    }


    /* =====================================================
       NOTIFICATIONS
    ===================================================== */

    match /notifications/{notificationId} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.userId == request.auth.uid
            ||
            resource.data.uid == request.auth.uid
            ||
            resource.data.customerId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
          )
        );


      /* ---------------------------------------------------
         CREATE

         Only trusted/admin code should create notifications.
      --------------------------------------------------- */

      allow create: if
        isAdmin();


      /* ---------------------------------------------------
         UPDATE

         User can only change read/seen state.
      --------------------------------------------------- */

      allow update: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.userId == request.auth.uid
            ||
            resource.data.uid == request.auth.uid
          )
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "read",
              "isRead",
              "seen",
              "readAt",
              "updatedAt"
            ])
        );


      allow delete: if
        isAdmin();

    }


    /* =====================================================
       SUPPORT
    ===================================================== */

    match /supports/{supportId} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.userId == request.auth.uid
            ||
            resource.data.uid == request.auth.uid
            ||
            resource.data.customerId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
          )
        );


      /* ---------------------------------------------------
         CREATE

         User may create only a support request belonging
         to the authenticated account.
      --------------------------------------------------- */

      allow create: if

        activeAccount()
        &&
        (
          request.resource.data.userId ==
            request.auth.uid
          ||
          request.resource.data.uid ==
            request.auth.uid
          ||
          request.resource.data.customerId ==
            request.auth.uid
          ||
          request.resource.data.riderId ==
            request.auth.uid
        );


      /* ---------------------------------------------------
         UPDATE

         User can update message-related fields only.

         Admin can manage support state.
      --------------------------------------------------- */

      allow update: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.userId == request.auth.uid
            ||
            resource.data.uid == request.auth.uid
            ||
            resource.data.customerId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
          )
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "message",
              "messages",
              "attachments",
              "updatedAt"
            ])
        );


      allow delete: if
        isAdmin();

    }


    /* =====================================================
       CHATS
    ===================================================== */

    match /chats/{chatId} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.customerId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
            ||
            resource.data.driverId == request.auth.uid
          )
        );


      /* ---------------------------------------------------
         CREATE

         Chat must contain the authenticated participant.
      --------------------------------------------------- */

      allow create: if

        activeAccount()
        &&
        (
          request.resource.data.customerId ==
            request.auth.uid
          ||
          request.resource.data.riderId ==
            request.auth.uid
          ||
          request.resource.data.driverId ==
            request.auth.uid
        );


      /* ---------------------------------------------------
         UPDATE

         Participants can update only safe chat metadata.

         Participant identities cannot be changed.
      --------------------------------------------------- */

      allow update: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.customerId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
            ||
            resource.data.driverId == request.auth.uid
          )
          &&
          request.resource.data.customerId ==
            resource.data.customerId
          &&
          request.resource.data.riderId ==
            resource.data.riderId
          &&
          request.resource.data.driverId ==
            resource.data.driverId
          &&
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "lastMessage",
              "lastMessageAt",
              "lastSenderId",
              "updatedAt",
              "customerTyping",
              "riderTyping",
              "driverTyping"
            ])
        );


      allow delete: if
        isAdmin();

    }


    /* =====================================================
       CHAT MESSAGES
       /chats/{chatId}/messages/{messageId}
    ===================================================== */

    match /chats/{chatId}/messages/{messageId} {


      /* ---------------------------------------------------
         CHAT PARTICIPANT HELPER IS REPEATED INLINE BECAUSE
         FIRESTORE RULES NESTED PATHS REQUIRE THE CHAT
         DOCUMENT TO BE CHECKED.
      --------------------------------------------------- */

      allow read: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          exists(
            /databases/$(database)/documents/chats/$(chatId)
          )
          &&
          (
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.customerId == request.auth.uid

            ||

            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.riderId == request.auth.uid

            ||

            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.driverId == request.auth.uid
          )
        );


      /* ---------------------------------------------------
         CREATE

         Sender MUST be authenticated and must be a member
         of the parent chat.
      --------------------------------------------------- */

      allow create: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          exists(
            /databases/$(database)/documents/chats/$(chatId)
          )
          &&
          (
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.customerId == request.auth.uid

            ||

            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.riderId == request.auth.uid

            ||

            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.driverId == request.auth.uid
          )
          &&
          request.resource.data.senderId ==
            request.auth.uid
        );


      /* ---------------------------------------------------
         MESSAGE EDITING IS ADMIN-ONLY.

         Normal users cannot rewrite chat history.
      --------------------------------------------------- */

      allow update: if
        isAdmin();


      allow delete: if
        isAdmin();

    }


    /* =====================================================
       REFERRALS
    ===================================================== */

    match /referrals/{referralId} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.userId == request.auth.uid
            ||
            resource.data.referrerId == request.auth.uid
            ||
            resource.data.referredUserId == request.auth.uid
          )
        );


      /* ---------------------------------------------------
         CREATE

         A user may create only a referral associated with
         themselves.

         Reward/financial fields are not accepted from the
         client at update time.
      --------------------------------------------------- */

      allow create: if

        activeAccount()
        &&
        (
          request.resource.data.userId ==
            request.auth.uid
          ||
          request.resource.data.referrerId ==
            request.auth.uid
        );


      /* ---------------------------------------------------
         UPDATE

         Referral rewards/status are trusted data.
      --------------------------------------------------- */

      allow update: if
        isAdmin();


      allow delete: if
        isAdmin();

    }


    /* =====================================================
       RATINGS
    ===================================================== */

    match /ratings/{ratingId} {


      /* ---------------------------------------------------
         READ
      --------------------------------------------------- */

      allow read: if

        isAdmin()

        ||

        (
          activeAccount()
          &&
          (
            resource.data.customerId == request.auth.uid
            ||
            resource.data.riderId == request.auth.uid
          )
        );


      /* ---------------------------------------------------
         CREATE

         Customer can submit a rating.

         Rating identity cannot be forged.
      --------------------------------------------------- */

      allow create: if

        activeAccount()
        &&
        isCustomer()
        &&
        request.resource.data.customerId ==
          request.auth.uid;


      /* ---------------------------------------------------
         UPDATE

         Ratings are intentionally immutable for normal
         users. Admin can moderate/correct them.
      --------------------------------------------------- */

      allow update: if
        isAdmin();


      allow delete: if
        isAdmin();

    }


    /* =====================================================
       FARE SETTINGS
    ===================================================== */

    match /fareSettings/{documentId} {


      /* ---------------------------------------------------
         Read pricing configuration.

         Authenticated application users may read.
      --------------------------------------------------- */

      allow read: if
        activeAccount();


      /* ---------------------------------------------------
         Only admin can change pricing.
      --------------------------------------------------- */

      allow write: if
        isAdmin();

    }


    /* =====================================================
       GENERAL APP SETTINGS
    ===================================================== */

    match /settings/{documentId} {


      allow read: if
        activeAccount();


      allow write: if
        isAdmin();

    }


    /* =====================================================
       ADMIN COLLECTION
    ===================================================== */

    match /admin/{documentId} {


      allow read, write: if
        isAdmin();

    }


    /* =====================================================
       DEFAULT DENY
       -----------------------------------------------------
       Anything not explicitly allowed above is denied.
    ===================================================== */

    match /{document=**} {

      allow read, write: if
        false;

    }

  }

}
