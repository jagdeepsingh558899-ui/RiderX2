rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    // =========================================================
    // COMMON FUNCTIONS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }


    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }


    function isAdmin() {
      return signedIn()
        && (
          userDoc().data.role == "admin"
          || userDoc().data.role == "administrator"
          || userDoc().data.isAdmin == true
        );
    }


    function isRider() {
      return signedIn()
        && userDoc().data.role == "rider";
    }


    function isCustomer() {
      return signedIn()
        && userDoc().data.role == "customer";
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );


      allow create: if signedIn()
        && request.auth.uid == userId;


      allow update: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // RIDERS
    // =========================================================

    match /riders/{riderId} {

      allow read: if signedIn()
        && (
          request.auth.uid == riderId
          || isAdmin()
        );


      allow create: if signedIn()
        && request.auth.uid == riderId;


      allow update: if signedIn()
        && (
          request.auth.uid == riderId
          || isAdmin()
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // CUSTOMERS
    // =========================================================

    match /customers/{customerId} {

      allow read: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );


      allow create: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );


      allow update: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // RIDES
    // =========================================================

    match /rides/{rideId} {

      // -------------------------------------------------------
      // CREATE RIDE
      // Customer can create only his own ride.
      // -------------------------------------------------------

      allow create: if signedIn()
        && (
          (
            isCustomer()
            && request.resource.data.customerId ==
               request.auth.uid
          )
          ||
          isAdmin()
        );


      // -------------------------------------------------------
      // READ RIDE
      //
      // Customer:
      //   - Own rides
      //
      // Rider:
      //   - Own accepted/active rides
      //   - Searching rides
      //   - REQUESTED rides
      //
      // Admin:
      //   - Everything
      // -------------------------------------------------------

      allow read: if signedIn()
        && (
          resource.data.customerId ==
            request.auth.uid

          ||

          resource.data.riderId ==
            request.auth.uid

          ||

          (
            isRider()
            &&
            (
              resource.data.status == "searching"
              ||
              resource.data.status == "REQUESTED"
            )
          )

          ||

          isAdmin()
        );


      // -------------------------------------------------------
      // UPDATE RIDE
      // -------------------------------------------------------

      allow update: if signedIn()
        && (

          // Admin can update anything
          isAdmin()


          ||

          // Customer can update/cancel his own ride
          (
            isCustomer()
            &&
            resource.data.customerId ==
              request.auth.uid
          )


          ||

          // Rider can update a ride already assigned to him
          (
            isRider()
            &&
            resource.data.riderId ==
              request.auth.uid
          )


          ||

          // IMPORTANT:
          // Rider can ACCEPT a searching/REQUESTED ride.
          //
          // Before acceptance riderId is normally empty/null.
          // After update riderId must become current rider UID.
          //
          (
            isRider()
            &&
            (
              resource.data.status == "searching"
              ||
              resource.data.status == "REQUESTED"
            )
            &&
            request.resource.data.riderId ==
              request.auth.uid
            &&
            (
              request.resource.data.status == "ACCEPTED"
              ||
              request.resource.data.status == "accepted"
            )
          )
        );


      // -------------------------------------------------------
      // DELETE
      // -------------------------------------------------------

      allow delete: if isAdmin();
    }


    // =========================================================
    // WALLETS
    // =========================================================

    match /wallets/{walletId} {

      allow read: if signedIn()
        && (
          request.auth.uid == walletId
          || isAdmin()
        );


      allow create: if signedIn()
        && (
          request.auth.uid == walletId
          || isAdmin()
        );


      allow update: if signedIn()
        && (
          request.auth.uid == walletId
          || isAdmin()
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // SUPPORT
    // =========================================================

    match /support/{supportId} {

      allow read: if signedIn();


      allow create: if signedIn();


      allow update: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
            request.auth.uid
        );


      allow delete: if isAdmin();
    }


    // =========================================================
    // SETTINGS
    // =========================================================

    match /settings/{settingId} {

      // Customer/Rider/Admin can read settings
      allow read: if signedIn();


      // Only Admin can change settings
      allow write: if isAdmin();
    }


    // =========================================================
    // NOTIFICATIONS
    // =========================================================

    match /notifications/{notificationId} {

      allow read: if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          ||
          isAdmin()
        );


      allow create: if signedIn();


      allow update: if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          ||
          isAdmin()
        );


      allow delete: if signedIn()
        && (
          resource.data.userId ==
            request.auth.uid
          ||
          isAdmin()
        );
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {

      allow read, write: if false;

    }

  }
}
