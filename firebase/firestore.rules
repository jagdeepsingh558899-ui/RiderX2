rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    function loggedIn(){
      return request.auth != null;
    }


    function userData(){
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }


    function admin(){
      return loggedIn() && userData().role == "admin";
    }


    function rider(){
      return loggedIn() && userData().role == "rider";
    }



    // USERS

    match /users/{uid} {

      allow read: if loggedIn();

      allow create:
      if loggedIn()
      && request.auth.uid == uid;


      allow update:
      if loggedIn()
      && (request.auth.uid == uid || admin());


      allow delete:
      if admin();
    }




    // RIDER DOCUMENTS

    match /drivers/{uid} {

      allow read:
      if loggedIn();


      allow create, update:
      if loggedIn()
      && request.auth.uid == uid;


      allow delete:
      if admin();
    }




    // RIDES SYSTEM

    match /rides/{rideId} {


      allow create:
      if loggedIn()
      && request.resource.data.customerId == request.auth.uid;



      allow read:
      if loggedIn();



      allow update:
      if loggedIn()
      && (

        // Customer update own ride
        resource.data.customerId == request.auth.uid

        ||

        // Rider accept assigned ride
        request.resource.data.driverId == request.auth.uid

        ||

        // Admin control
        admin()

      );



      allow delete:
      if admin();

    }




    // CHAT

    match /chats/{chatId} {

      allow read, write:
      if loggedIn();

    }




    // WALLET

    match /wallets/{uid} {

      allow read:
      if loggedIn()
      && request.auth.uid == uid;


      allow write:
      if admin();

    }




    // NOTIFICATIONS

    match /notifications/{uid}/items/{id} {

      allow read:
      if loggedIn()
      && request.auth.uid == uid;


      allow write:
      if loggedIn();

    }




    // ADMIN SETTINGS

    match /settings/{id} {

      allow read:
      if loggedIn();


      allow write:
      if admin();

    }

  }
}
