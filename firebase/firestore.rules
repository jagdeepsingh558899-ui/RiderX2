rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================================
       COMMON HELPERS
    ===================================================== */

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userExists(uid) {
      return exists(userPath(uid));
    }

    function userData(uid) {
      return get(userPath(uid)).data;
    }

    function isAdmin() {
      return signedIn()
        && userExists(request.auth.uid)
        && (
          userData(request.auth.uid).role == "admin"
          || userData(request.auth.uid).userRole == "admin"
          || userData(request.auth.uid).accountType == "admin"
          || userData(request.auth.uid).isAdmin == true
        );
    }

    function isCustomer() {
      return signedIn()
        && userExists(request.auth.uid)
        && !isAdmin()
        && (
          userData(request.auth.uid).role == "customer"
          || userData(request.auth.uid).userRole == "customer"
          || userData(request.auth.uid).accountType == "customer"
          || userData(request.auth.uid).role == "user"
        );
    }

    function isRider() {
      return signedIn()
        && userExists(request.auth.uid)
        && !isAdmin()
        && (
          userData(request.auth.uid).role == "rider"
          || userData(request.auth.uid).userRole == "rider"
          || userData(request.auth.uid).accountType == "rider"
          || userData(request.auth.uid).userType == "rider"
        );
    }

    function activeAccount() {
      return signedIn()
        && userExists(request.auth.uid)
        && userData(request.auth.uid).disabled != true
        && userData(request.auth.uid).blocked != true
        && userData(request.auth.uid).status != "disabled"
        && userData(request.auth.uid).status != "blocked"
        && userData(request.auth.uid).status != "suspended";
    }

    function riderPath(uid) {
      return /databases/$(database)/documents/riders/$(uid);
    }

    function riderExists(uid) {
      return exists(riderPath(uid));
    }

    function riderData(uid) {
      return get(riderPath(uid)).data;
    }

    function riderApproved() {
      return signedIn()
        && riderExists(request.auth.uid)
        && (
          riderData(request.auth.uid).adminApproved == true
          || riderData(request.auth.uid).approved == true
          || riderData(request.auth.uid).isApproved == true
          || riderData(request.auth.uid).approvalStatus == "approved"
          || riderData(request.auth.uid).status == "approved"
          || riderData(request.auth.uid).riderStatus == "approved"
        );
    }

    function isRideParticipant(resourceData) {
      return signedIn()
        && (
          resourceData.customerId == request.auth.uid
          || resourceData.userId == request.auth.uid
          || resourceData.riderId == request.auth.uid
          || resourceData.driverId == request.auth.uid
        );
    }

    function isBookingParticipant(resourceData) {
      return signedIn()
        && (
          resourceData.customerId == request.auth.uid
          || resourceData.userId == request.auth.uid
          || resourceData.riderId == request.auth.uid
          || resourceData.driverId == request.auth.uid
        );
    }


    /* =====================================================
       USERS
    ===================================================== */

    match /users/{uid} {

      allow read: if
        isOwner(uid) || isAdmin();


      /*
       * Customer/rider may create only their own account.
       * Admin cannot be created from the client.
       */

      allow create: if
        isOwner(uid)
        && !(
          request.resource.data.role == "admin"
          || request.resource.data.userRole == "admin"
          || request.resource.data.accountType == "admin"
          || request.resource.data.isAdmin == true
        )
        && (
          request.resource.data.role == "customer"
          || request.resource.data.role == "rider"
          || request.resource.data.userRole == "customer"
          || request.resource.data.userRole == "rider"
          || request.resource.data.accountType == "customer"
          || request.resource.data.accountType == "rider"
        );


      /*
       * Own profile updates are restricted to safe profile fields.
       * Role, approval, wallet and security fields cannot be changed.
       */

      allow update: if
        isAdmin()

        ||

        (
          isOwner(uid)

          &&

          request.resource.data.role == resource.data.role
          && request.resource.data.userRole == resource.data.userRole
          && request.resource.data.accountType == resource.data.accountType
          && request.resource.data.isAdmin == resource.data.isAdmin

          &&

          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "name",
              "fullName",
              "displayName",
              "firstName",
              "lastName",
              "phone",
              "mobile",
              "phoneNumber",
              "email",
              "photoURL",
              "profileImage",
              "city",
              "address",
              "language",
              "notificationEnabled",
              "notificationToken",
              "notificationUpdatedAt",
              "fcmToken",
              "pushToken",
              "updatedAt",
              "lastSeenAt"
            ])
        );


      allow delete: if isAdmin();
    }


    /* =====================================================
       RIDERS
    ===================================================== */

    match /riders/{uid} {

      allow read: if
        isOwner(uid)
        || isAdmin()
        || (
          signedIn()
          && isCustomer()
        );


      /*
       * Rider creates own application.
       * Approval fields cannot be set to approved by rider.
       */

      allow create: if
        isOwner(uid)
        && isRider()
        && request.resource.data.uid == uid
        && request.resource.data.approved != true
        && request.resource.data.isApproved != true
        && request.resource.data.adminApproved != true
        && request.resource.data.approvalStatus != "approved"
        && request.resource.data.status != "approved";


      /*
       * Rider may update operational/profile data.
       * Approval/security fields remain admin-controlled.
       */

      allow update: if
        isAdmin()

        ||

        (
          isOwner(uid)
          && riderApproved()

          &&

          request.resource.data.uid == resource.data.uid

          &&

          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "name",
              "fullName",
              "displayName",
              "firstName",
              "lastName",
              "phone",
              "mobile",
              "phoneNumber",
              "email",
              "photoURL",
              "profileImage",
              "city",
              "address",
              "vehicle",
              "vehicleType",
              "bikeModel",
              "bikeNumber",
              "licenseNumber",
              "drivingLicense",
              "documents",
              "online",
              "isOnline",
              "currentRideId",
              "currentBookingId",
              "latitude",
              "longitude",
              "location",
              "lastLocation",
              "updatedAt",
              "lastSeenAt",
              "fcmToken",
              "pushToken",
              "language",
              "notificationEnabled"
            ])
        );


      allow delete: if isAdmin();
    }


    /* =====================================================
       RIDES
    ===================================================== */

    match /rides/{rideId} {

      allow read: if
        isAdmin()
        || isRideParticipant(resource.data);


      /*
       * Customer creates a new ride request.
       */

      allow create: if
        isCustomer()
        && activeAccount()
        && request.resource.data.customerId == request.auth.uid
        && (
          request.resource.data.status == "REQUESTED"
          || request.resource.data.status == "requested"
          || request.resource.data.status == "SEARCHING"
          || request.resource.data.status == "searching"
          || request.resource.data.status == "PENDING"
          || request.resource.data.status == "pending"
        )
        && (
          request.resource.data.riderId == null
          || request.resource.data.riderId == ""
        )
        && (
          request.resource.data.driverId == null
          || request.resource.data.driverId == ""
        );


      /*
       * Customer can cancel only their own unaccepted ride.
       */

      allow update: if

        isAdmin()

        ||

        (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && (
            resource.data.riderId == null
            || resource.data.riderId == ""
          )
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.riderId == resource.data.riderId
          && request.resource.data.driverId == resource.data.driverId
          && (
            request.resource.data.status == "CANCELLED"
            || request.resource.data.status == "cancelled"
            || request.resource.data.status == "CANCELED"
            || request.resource.data.status == "canceled"
          )
        )

        ||

        /*
         * Approved rider accepts an unassigned request.
         */

        (
          riderApproved()
          && (
            resource.data.status == "REQUESTED"
            || resource.data.status == "requested"
            || resource.data.status == "SEARCHING"
            || resource.data.status == "searching"
            || resource.data.status == "PENDING"
            || resource.data.status == "pending"
          )
          && (
            resource.data.riderId == null
            || resource.data.riderId == ""
          )
          && (
            resource.data.driverId == null
            || resource.data.driverId == ""
          )
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.riderId == request.auth.uid
          && request.resource.data.driverId == request.auth.uid
          && (
            request.resource.data.status == "ACCEPTED"
            || request.resource.data.status == "accepted"
          )
        )

        ||

        /*
         * Assigned rider can update the ride.
         * Rider/driver IDs cannot be transferred.
         */

        (
          riderApproved()
          && (
            resource.data.riderId == request.auth.uid
            || resource.data.driverId == request.auth.uid
          )
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.riderId == resource.data.riderId
          && request.resource.data.driverId == resource.data.driverId
        );


      allow delete: if isAdmin();
    }


    /* =====================================================
       BOOKINGS
    ===================================================== */

    match /bookings/{bookingId} {

      allow read: if
        isAdmin()
        || isBookingParticipant(resource.data);


      /*
       * Customer creates own booking.
       */

      allow create: if
        (
          isCustomer()
          && activeAccount()
          && (
            request.resource.data.customerId == request.auth.uid
            || request.resource.data.userId == request.auth.uid
          )
        )
        ||
        isAdmin();


      /*
       * Only associated users or admin may update.
       */

      allow update: if
        isAdmin()
        ||
        (
          signedIn()
          && isBookingParticipant(resource.data)
          && (
            request.resource.data.customerId == resource.data.customerId
            || request.resource.data.customerId == null
            || request.resource.data.customerId == ""
          )
          && (
            request.resource.data.userId == resource.data.userId
            || request.resource.data.userId == null
            || request.resource.data.userId == ""
          )
          && (
            request.resource.data.riderId == resource.data.riderId
            || request.resource.data.riderId == request.auth.uid
            || request.resource.data.riderId == null
            || request.resource.data.riderId == ""
          )
          && (
            request.resource.data.driverId == resource.data.driverId
            || request.resource.data.driverId == request.auth.uid
            || request.resource.data.driverId == null
            || request.resource.data.driverId == ""
          )
        );


      allow delete: if isAdmin();
    }


    /* =====================================================
       WALLET
    ===================================================== */

    match /wallet/{uid} {

      allow read: if
        isOwner(uid) || isAdmin();


      /*
       * Wallet balance is trusted financial data.
       * Client cannot create/update/delete it.
       */

      allow create: if isAdmin();

      allow update: if isAdmin();

      allow delete: if isAdmin();


      match /transactions/{transactionId} {

        allow read: if
          isOwner(uid) || isAdmin();

        allow create: if isAdmin();

        allow update: if isAdmin();

        allow delete: if isAdmin();
      }
    }


    /* =====================================================
       NOTIFICATIONS
    ===================================================== */

    match /notifications/{notificationId} {

      allow read: if
        isAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
            || resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
          )
        );


      /*
       * Notifications are created by trusted/admin code.
       */

      allow create: if isAdmin();


      /*
       * User may only mark notification state.
       */

      allow update: if
        isAdmin()
        ||
        (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "read",
              "isRead",
              "seen",
              "readAt",
              "updatedAt"
            ])
        );


      allow delete: if isAdmin();
    }


    /* =====================================================
       SUPPORT
    ===================================================== */

    match /supports/{supportId} {

      allow read: if
        isAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
            || resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
          )
        );


      allow create: if
        signedIn()
        && (
          request.resource.data.userId == request.auth.uid
          || request.resource.data.uid == request.auth.uid
          || request.resource.data.customerId == request.auth.uid
          || request.resource.data.riderId == request.auth.uid
        );


      allow update: if
        isAdmin()
        ||
        (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
            || resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
          )
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "message",
              "messages",
              "attachments",
              "updatedAt"
            ])
        );


      allow delete: if isAdmin();
    }


    /* =====================================================
       CHATS
    ===================================================== */

    match /chats/{chatId} {

      allow read: if
        isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
            || resource.data.driverId == request.auth.uid
          )
        );


      allow create: if
        signedIn()
        && (
          request.resource.data.customerId == request.auth.uid
          || request.resource.data.riderId == request.auth.uid
          || request.resource.data.driverId == request.auth.uid
          || isAdmin()
        );


      allow update: if
        isAdmin()
        ||
        (
          signedIn()
          && (
            resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
            || resource.data.driverId == request.auth.uid
          )
        );


      allow delete: if isAdmin();
    }


    /* =====================================================
       CHAT MESSAGES
    ===================================================== */

    match /chats/{chatId}/messages/{messageId} {

      function chatParticipant() {
        return signedIn()
          && exists(
            /databases/$(database)/documents/chats/$(chatId)
          )
          && (
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.customerId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.riderId == request.auth.uid
            ||
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.driverId == request.auth.uid
          );
      }


      allow read: if
        isAdmin() || chatParticipant();


      allow create: if
        isAdmin()
        ||
        (
          chatParticipant()
          && request.resource.data.senderId == request.auth.uid
        );


      /*
       * Messages are immutable from clients.
       */

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    /* =====================================================
       REFERRALS
    ===================================================== */

    match /referrals/{referralId} {

      allow read: if
        isAdmin()
        || (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.referrerId == request.auth.uid
            || resource.data.referredUserId == request.auth.uid
          )
        );


      allow create: if
        signedIn()
        && (
          request.resource.data.userId == request.auth.uid
          || request.resource.data.referrerId == request.auth.uid
        );


      /*
       * Referral rewards are trusted financial data.
       */

      allow update: if isAdmin();

      allow delete: if isAdmin();
    }


    /* =====================================================
       RATINGS
    ===================================================== */

    match /ratings/{ratingId} {

      allow read: if
        isAdmin()
        || (
          signedIn()
          && (
            resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
          )
        );


      /*
       * Customer can submit a rating.
       */

      allow create: if
        isCustomer()
        && request.resource.data.customerId == request.auth.uid;


      /*
       * Customer may edit own rating.
       */

      allow update: if
        isAdmin()
        ||
        (
          isCustomer()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
        );


      allow delete: if isAdmin();
    }


    /* =====================================================
       FARE SETTINGS
    ===================================================== */

    match /fareSettings/{documentId} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }


    /* =====================================================
       APP SETTINGS
    ===================================================== */

    match /settings/{documentId} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }


    /* =====================================================
       ADMIN
    ===================================================== */

    match /admin/{documentId} {

      allow read, write: if isAdmin();
    }


    /* =====================================================
       DEFAULT DENY
    ===================================================== */

    match /{document=**} {

      allow read, write: if false;
    }
  }
}
