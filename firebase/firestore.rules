rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================================
       COMMON HELPERS
    ===================================================== */

    function signedIn() {
      return request.auth != null;
    }


    function isOwner(uid) {
      return signedIn()
        && request.auth.uid == uid;
    }


    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }


    function userExists(uid) {
      return exists(userPath(uid));
    }


    function userData(uid) {
      return get(userPath(uid)).data;
    }


    function isAdmin() {
      return signedIn()
        && userExists(request.auth.uid)
        && (
          userData(request.auth.uid).role == "admin"
          || userData(request.auth.uid).userRole == "admin"
          || userData(request.auth.uid).accountType == "admin"
          || userData(request.auth.uid).isAdmin == true
        );
    }


    function isCustomer() {
      return signedIn()
        && userExists(request.auth.uid)
        && !isAdmin()
        && (
          userData(request.auth.uid).role == "customer"
          || userData(request.auth.uid).userRole == "customer"
          || userData(request.auth.uid).accountType == "customer"
          || userData(request.auth.uid).role == "user"
        );
    }


    function isRider() {
      return signedIn()
        && userExists(request.auth.uid)
        && !isAdmin()
        && (
          userData(request.auth.uid).role == "rider"
          || userData(request.auth.uid).userRole == "rider"
          || userData(request.auth.uid).accountType == "rider"
          || userData(request.auth.uid).userType == "rider"
        );
    }


    function activeAccount() {
      return signedIn()
        && userExists(request.auth.uid)
        && userData(request.auth.uid).disabled != true
        && userData(request.auth.uid).blocked != true
        && userData(request.auth.uid).status != "disabled"
        && userData(request.auth.uid).status != "blocked"
        && userData(request.auth.uid).status != "suspended";
    }


    /* =====================================================
       RIDER HELPERS
    ===================================================== */

    function riderPath(uid) {
      return /databases/$(database)/documents/riders/$(uid);
    }


    function riderExists(uid) {
      return exists(riderPath(uid));
    }


    function riderData(uid) {
      return get(riderPath(uid)).data;
    }


    function riderApproved() {
      return signedIn()
        && isRider()
        && riderExists(request.auth.uid)
        && (
          riderData(request.auth.uid).adminApproved == true
          || riderData(request.auth.uid).approved == true
          || riderData(request.auth.uid).isApproved == true
          || riderData(request.auth.uid).approvalStatus == "approved"
          || riderData(request.auth.uid).status == "approved"
          || riderData(request.auth.uid).riderStatus == "approved"
        );
    }


    function canReceiveRideRequests() {
      return
        riderApproved()
        && activeAccount();
    }


    /* =====================================================
       RIDE HELPERS
    ===================================================== */

    function isRideParticipant(resourceData) {
      return signedIn()
        && (
          resourceData.customerId == request.auth.uid
          || resourceData.userId == request.auth.uid
          || resourceData.riderId == request.auth.uid
          || resourceData.driverId == request.auth.uid
        );
    }


    function isBookingParticipant(resourceData) {
      return signedIn()
        && (
          resourceData.customerId == request.auth.uid
          || resourceData.userId == request.auth.uid
          || resourceData.riderId == request.auth.uid
          || resourceData.driverId == request.auth.uid
        );
    }


    function isSearchingRide(resourceData) {
      return
        resourceData.status == "REQUESTED"
        || resourceData.status == "requested"
        || resourceData.status == "SEARCHING"
        || resourceData.status == "searching"
        || resourceData.status == "PENDING"
        || resourceData.status == "pending";
    }


    function isCancelledStatus(status) {
      return
        status == "CANCELLED"
        || status == "cancelled"
        || status == "CANCELED"
        || status == "canceled";
    }


    function isAcceptedStatus(status) {
      return
        status == "ACCEPTED"
        || status == "accepted";
    }


    function isActiveRideStatus(status) {
      return
        status == "ACCEPTED"
        || status == "accepted"
        || status == "ARRIVING"
        || status == "arriving"
        || status == "ARRIVED"
        || status == "arrived"
        || status == "STARTED"
        || status == "started"
        || status == "IN_PROGRESS"
        || status == "in_progress"
        || status == "ONGOING"
        || status == "ongoing";
    }


    /* =====================================================
       USERS
    ===================================================== */

    match /users/{uid} {

      allow read: if
        isOwner(uid)
        || isAdmin();


      /*
       * A user may create only their own customer/rider
       * account.
       *
       * Admin cannot be created from the client.
       */

      allow create: if
        isOwner(uid)
        && !(
          request.resource.data.role == "admin"
          || request.resource.data.userRole == "admin"
          || request.resource.data.accountType == "admin"
          || request.resource.data.isAdmin == true
        )
        && (
          request.resource.data.role == "customer"
          || request.resource.data.role == "rider"
          || request.resource.data.userRole == "customer"
          || request.resource.data.userRole == "rider"
          || request.resource.data.accountType == "customer"
          || request.resource.data.accountType == "rider"
        );


      /*
       * Own profile updates are restricted.
       *
       * Role, admin state, approval state, wallet state
       * and other security-sensitive fields cannot be
       * changed by the user.
       */

      allow update: if
        isAdmin()

        ||

        (
          isOwner(uid)

          && request.resource.data.role == resource.data.role

          && request.resource.data.userRole == resource.data.userRole

          && request.resource.data.accountType == resource.data.accountType

          && request.resource.data.isAdmin == resource.data.isAdmin

          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "name",
              "fullName",
              "displayName",
              "firstName",
              "lastName",
              "phone",
              "mobile",
              "phoneNumber",
              "email",
              "photoURL",
              "profileImage",
              "city",
              "address",
              "language",
              "notificationEnabled",
              "notificationToken",
              "notificationUpdatedAt",
              "fcmToken",
              "pushToken",
              "updatedAt",
              "lastSeenAt"
            ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       RIDERS
    ===================================================== */

    match /riders/{uid} {

      /*
       * Rider can see own profile.
       * Customer can see rider information.
       * Admin can see everything.
       */

      allow read: if
        isOwner(uid)
        || isAdmin()
        || (
          signedIn()
          && isCustomer()
        );


      /*
       * Rider creates own application.
       *
       * Rider cannot self-approve.
       */

      allow create: if
        isOwner(uid)
        && isRider()
        && request.resource.data.uid == uid
        && request.resource.data.approved != true
        && request.resource.data.isApproved != true
        && request.resource.data.adminApproved != true
        && request.resource.data.approvalStatus != "approved"
        && request.resource.data.status != "approved";


      /*
       * Rider may update operational/profile fields only
       * after approval.
       *
       * Approval/security fields remain admin-controlled.
       */

      allow update: if
        isAdmin()

        ||

        (
          isOwner(uid)
          && activeAccount()
          && riderApproved()

          && request.resource.data.uid == resource.data.uid

          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "name",
              "fullName",
              "displayName",
              "firstName",
              "lastName",
              "phone",
              "mobile",
              "phoneNumber",
              "email",
              "photoURL",
              "profileImage",
              "city",
              "address",
              "vehicle",
              "vehicleType",
              "bikeModel",
              "bikeNumber",
              "licenseNumber",
              "drivingLicense",
              "documents",
              "online",
              "isOnline",
              "currentRideId",
              "currentBookingId",
              "latitude",
              "longitude",
              "location",
              "lastLocation",
              "updatedAt",
              "lastSeenAt",
              "fcmToken",
              "pushToken",
              "language",
              "notificationEnabled"
            ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       RIDES
    ===================================================== */

    match /rides/{rideId} {

      /*
       * IMPORTANT:
       *
       * Customer:
       *   Can read own ride.
       *
       * Assigned rider:
       *   Can read own assigned ride.
       *
       * Admin:
       *   Can read all rides.
       *
       * Approved active rider:
       *   Can read unassigned searching rides.
       *
       * This last condition is required because
       * rider/home.html listens for:
       *
       *   where("status", "==", "searching")
       *
       * before the ride has a riderId.
       */

      allow read: if
        isAdmin()

        ||

        isRideParticipant(resource.data)

        ||

        (
          canReceiveRideRequests()
          && isSearchingRide(resource.data)
          && (
            resource.data.riderId == null
            || resource.data.riderId == ""
          )
          && (
            resource.data.driverId == null
            || resource.data.driverId == ""
          )
        );


      /*
       * CUSTOMER CREATES RIDE
       */

      allow create: if
        isCustomer()
        && activeAccount()

        && request.resource.data.customerId == request.auth.uid

        && isSearchingRide(request.resource.data)

        && (
          request.resource.data.riderId == null
          || request.resource.data.riderId == ""
        )

        && (
          request.resource.data.driverId == null
          || request.resource.data.driverId == ""
        );


      /*
       * CUSTOMER CANCELS OWN UNASSIGNED RIDE
       */

      allow update: if

        isAdmin()

        ||

        (
          isCustomer()

          && activeAccount()

          && resource.data.customerId == request.auth.uid

          && (
            resource.data.riderId == null
            || resource.data.riderId == ""
          )

          && (
            resource.data.driverId == null
            || resource.data.driverId == ""
          )

          && request.resource.data.customerId
              == resource.data.customerId

          && request.resource.data.riderId
              == resource.data.riderId

          && request.resource.data.driverId
              == resource.data.driverId

          && isCancelledStatus(
               request.resource.data.status
             )
        )

        ||

        /*
         * APPROVED RIDER ACCEPTS SEARCHING RIDE
         *
         * Only riderId is assigned here.
         *
         * driverId is NOT forced to become rider UID.
         *
         * This matches the actual RiderX rider/home.html
         * acceptance implementation.
         */

        (
          canReceiveRideRequests()

          && isSearchingRide(resource.data)

          && (
            resource.data.riderId == null
            || resource.data.riderId == ""
          )

          && (
            resource.data.driverId == null
            || resource.data.driverId == ""
          )

          && request.resource.data.customerId
              == resource.data.customerId

          && request.resource.data.riderId
              == request.auth.uid

          && (
            request.resource.data.driverId
              == resource.data.driverId

            || request.resource.data.driverId == null

            || request.resource.data.driverId == ""
          )

          && isAcceptedStatus(
               request.resource.data.status
             )
        )

        ||

        /*
         * ASSIGNED RIDER / DRIVER UPDATES OWN RIDE
         *
         * Existing customer/rider/driver ownership cannot
         * be transferred.
         */

        (
          canReceiveRideRequests()

          && (
            resource.data.riderId == request.auth.uid
            || resource.data.driverId == request.auth.uid
          )

          && request.resource.data.customerId
              == resource.data.customerId

          && request.resource.data.riderId
              == resource.data.riderId

          && request.resource.data.driverId
              == resource.data.driverId
        );


      /*
       * Only admin may delete rides.
       */

      allow delete: if
        isAdmin();
    }


    /* =====================================================
       BOOKINGS
    ===================================================== */

    match /bookings/{bookingId} {

      allow read: if
        isAdmin()
        || isBookingParticipant(resource.data);


      /*
       * Customer creates own booking.
       */

      allow create: if
        (
          isCustomer()
          && activeAccount()
          && (
            request.resource.data.customerId == request.auth.uid
            || request.resource.data.userId == request.auth.uid
          )
        )
        ||
        isAdmin();


      /*
       * Only associated users or admin may update.
       *
       * Ownership IDs cannot be transferred to another
       * user.
       */

      allow update: if
        isAdmin()

        ||

        (
          signedIn()
          && isBookingParticipant(resource.data)

          && (
            request.resource.data.customerId
              == resource.data.customerId
            || request.resource.data.customerId == null
            || request.resource.data.customerId == ""
          )

          && (
            request.resource.data.userId
              == resource.data.userId
            || request.resource.data.userId == null
            || request.resource.data.userId == ""
          )

          && (
            request.resource.data.riderId
              == resource.data.riderId
            || request.resource.data.riderId == request.auth.uid
            || request.resource.data.riderId == null
            || request.resource.data.riderId == ""
          )

          && (
            request.resource.data.driverId
              == resource.data.driverId
            || request.resource.data.driverId == request.auth.uid
            || request.resource.data.driverId == null
            || request.resource.data.driverId == ""
          )
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       WALLET
    ===================================================== */

    match /wallet/{uid} {

      /*
       * User can only read own wallet.
       * Admin can read all wallets.
       */

      allow read: if
        isOwner(uid)
        || isAdmin();


      /*
       * Wallet balance is trusted financial data.
       *
       * Client cannot directly create/update/delete wallet
       * balance.
       */

      allow create: if
        isAdmin();

      allow update: if
        isAdmin();

      allow delete: if
        isAdmin();


      match /transactions/{transactionId} {

        allow read: if
          isOwner(uid)
          || isAdmin();

        allow create: if
          isAdmin();

        allow update: if
          isAdmin();

        allow delete: if
          isAdmin();
      }
    }


    /* =====================================================
       NOTIFICATIONS
    ===================================================== */

    match /notifications/{notificationId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
            || resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
          )
        );


      /*
       * Notifications are trusted server/admin data.
       */

      allow create: if
        isAdmin();


      /*
       * User may only modify notification state.
       */

      allow update: if
        isAdmin()

        ||

        (
          signedIn()

          && (
            resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
          )

          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "read",
              "isRead",
              "seen",
              "readAt",
              "updatedAt"
            ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       SUPPORT
    ===================================================== */

    match /supports/{supportId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
            || resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
          )
        );


      allow create: if
        signedIn()
        && (
          request.resource.data.userId == request.auth.uid
          || request.resource.data.uid == request.auth.uid
          || request.resource.data.customerId == request.auth.uid
          || request.resource.data.riderId == request.auth.uid
        );


      allow update: if
        isAdmin()

        ||

        (
          signedIn()

          && (
            resource.data.userId == request.auth.uid
            || resource.data.uid == request.auth.uid
            || resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
          )

          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "message",
              "messages",
              "attachments",
              "updatedAt"
            ])
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       CHATS
    ===================================================== */

    match /chats/{chatId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
            || resource.data.driverId == request.auth.uid
          )
        );


      allow create: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            request.resource.data.customerId == request.auth.uid
            || request.resource.data.riderId == request.auth.uid
            || request.resource.data.driverId == request.auth.uid
          )
        );


      allow update: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
            || resource.data.driverId == request.auth.uid
          )
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       CHAT MESSAGES
    ===================================================== */

    match /chats/{chatId}/messages/{messageId} {

      function chatParticipant() {

        return signedIn()

          && exists(
            /databases/$(database)/documents/chats/$(chatId)
          )

          && (
            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.customerId == request.auth.uid

            ||

            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.riderId == request.auth.uid

            ||

            get(
              /databases/$(database)/documents/chats/$(chatId)
            ).data.driverId == request.auth.uid
          );
      }


      allow read: if
        isAdmin()
        || chatParticipant();


      allow create: if
        isAdmin()

        ||

        (
          chatParticipant()
          && request.resource.data.senderId == request.auth.uid
        );


      /*
       * Messages are immutable for clients.
       */

      allow update: if
        isAdmin();

      allow delete: if
        isAdmin();
    }


    /* =====================================================
       REFERRALS
    ===================================================== */

    match /referrals/{referralId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.userId == request.auth.uid
            || resource.data.referrerId == request.auth.uid
            || resource.data.referredUserId == request.auth.uid
          )
        );


      allow create: if
        signedIn()
        && (
          request.resource.data.userId == request.auth.uid
          || request.resource.data.referrerId == request.auth.uid
        );


      /*
       * Referral rewards are trusted financial data.
       */

      allow update: if
        isAdmin();

      allow delete: if
        isAdmin();
    }


    /* =====================================================
       RATINGS
    ===================================================== */

    match /ratings/{ratingId} {

      allow read: if
        isAdmin()

        ||

        (
          signedIn()
          && (
            resource.data.customerId == request.auth.uid
            || resource.data.riderId == request.auth.uid
          )
        );


      /*
       * Customer can submit a rating only for themselves.
       */

      allow create: if
        isCustomer()
        && activeAccount()
        && request.resource.data.customerId == request.auth.uid;


      /*
       * Customer can edit their own rating.
       */

      allow update: if
        isAdmin()

        ||

        (
          isCustomer()
          && activeAccount()
          && resource.data.customerId == request.auth.uid
          && request.resource.data.customerId
             == resource.data.customerId
        );


      allow delete: if
        isAdmin();
    }


    /* =====================================================
       FARE SETTINGS
    ===================================================== */

    match /fareSettings/{documentId} {

      allow read: if
        signedIn();

      allow write: if
        isAdmin();
    }


    /* =====================================================
       APP SETTINGS
    ===================================================== */

    match /settings/{documentId} {

      allow read: if
        signedIn();

      allow write: if
        isAdmin();
    }


    /* =====================================================
       ADMIN
    ===================================================== */

    match /admin/{documentId} {

      allow read, write: if
        isAdmin();
    }


    /* =====================================================
       DEFAULT DENY
    ===================================================== */

    match /{document=**} {

      allow read, write: if
        false;
    }

  }
}
