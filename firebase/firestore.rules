rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && (
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.role == "admin"
          ||
          get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.isAdmin == true
        );
    }

    function isRider() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "rider";
    }

    function isCustomer() {
      return signedIn()
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "customer";
    }


    /* =========================
       USERS
    ========================= */

    match /users/{userId} {

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if signedIn()
        && request.auth.uid == userId;

      allow update: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    /* =========================
       RIDERS
    ========================= */

    match /riders/{riderId} {

      allow read: if signedIn()
        && (
          request.auth.uid == riderId
          || isAdmin()
        );

      allow create: if signedIn()
        && request.auth.uid == riderId;

      allow update: if signedIn()
        && (
          request.auth.uid == riderId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    /* =========================
       CUSTOMERS
    ========================= */

    match /customers/{customerId} {

      allow read, create, update: if signedIn()
        && (
          request.auth.uid == customerId
          || isAdmin()
        );

      allow delete: if isAdmin();
    }


    /* =========================
       RIDES
    ========================= */

    match /rides/{rideId} {

      /* Customer creates his own ride */

      allow create: if signedIn()
        && request.resource.data.customerId ==
           request.auth.uid;


      /*
       * READ
       *
       * Customer:
       *   Can read own rides.
       *
       * Rider:
       *   Can read his assigned rides.
       *   Can read new "searching" ride requests.
       *
       * Admin:
       *   Can read everything.
       */

      allow read: if signedIn()
        && (
          resource.data.customerId ==
            request.auth.uid

          ||

          resource.data.riderId ==
            request.auth.uid

          ||

          (
            isRider()
            &&
            resource.data.status ==
              "searching"
          )

          ||

          isAdmin()
        );


      /*
       * UPDATE
       *
       * Admin:
       *   Can update everything.
       *
       * Customer:
       *   Can update own ride.
       *
       * Assigned rider:
       *   Can update his ride.
       *
       * New rider:
       *   Can accept a searching ride.
       */

      allow update: if signedIn()
        && (

          /* Admin */

          isAdmin()

          ||

          /* Customer's own ride */

          resource.data.customerId ==
            request.auth.uid

          ||

          /* Assigned rider */

          resource.data.riderId ==
            request.auth.uid

          ||

          /*
           * Rider accepts a new ride.
           *
           * Old status:
           * searching
           *
           * New status:
           * ACCEPTED
           *
           * Rider becomes riderId.
           */

          (
            isRider()

            &&

            resource.data.status ==
              "searching"

            &&

            (
              !("riderId" in resource.data)
              ||
              resource.data.riderId == null
              ||
              resource.data.riderId == ""
            )

            &&

            request.resource.data.status ==
              "ACCEPTED"

            &&

            request.resource.data.riderId ==
              request.auth.uid
          )
        );


      /* Only admin can delete rides */

      allow delete: if isAdmin();
    }


    /* =========================
       WALLETS
    ========================= */

    match /wallets/{walletId} {

      allow read, write: if signedIn()
        && (
          request.auth.uid == walletId
          || isAdmin()
        );
    }


    /* =========================
       SUPPORT
    ========================= */

    match /support/{supportId} {

      allow read, create: if signedIn();

      allow update: if signedIn()
        && (
          isAdmin()
          ||
          resource.data.userId ==
            request.auth.uid
        );

      allow delete: if isAdmin();
    }


    /* =========================
       SETTINGS
    ========================= */

    match /settings/{settingId} {

      allow read: if signedIn();

      allow write: if isAdmin();
    }


    /* =========================
       DEFAULT DENY
    ========================= */

    match /{document=**} {

      allow read, write: if false;

    }

  }
}
