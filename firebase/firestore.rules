rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    /* =====================================================
       HELPER FUNCTIONS
    ===================================================== */

    function loggedIn() {
      return request.auth != null;
    }


    function isOwner(uid) {
      return loggedIn()
        && request.auth.uid == uid;
    }


    function userExists() {
      return loggedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }


    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }


    function admin() {
      return loggedIn()
        && userExists()
        && (
          userData().role == "admin"
          ||
          userData().isAdmin == true
        );
    }


    function rider() {
      return loggedIn()
        && userExists()
        && userData().role == "rider";
    }


    function customer() {
      return loggedIn()
        && userExists()
        && (
          userData().role == "customer"
          ||
          userData().role == "user"
        );
    }


    /* =====================================================
       USERS
    ===================================================== */

    match /users/{uid} {

      /*
        Users can read their own profile.
        Admin can read all users.
      */

      allow read:
        if isOwner(uid)
        || admin();


      /*
        User can create own profile.
        Admin can create users.
      */

      allow create:
        if isOwner(uid)
        || admin();


      /*
        User can update own profile.
        Admin can update any profile.
      */

      allow update:
        if isOwner(uid)
        || admin();


      /*
        Only admin can delete users.
      */

      allow delete:
        if admin();
    }


    /* =====================================================
       RIDERS
    ===================================================== */

    match /riders/{uid} {

      /*
        Logged-in users can read rider information.
        Admin has full access.
      */

      allow read:
        if loggedIn();


      /*
        Rider can create/update own rider document.
        Admin can create/update any rider document.
      */

      allow create:
        if isOwner(uid)
        || admin();


      allow update:
        if isOwner(uid)
        || admin();


      /*
        Only admin can delete rider records.
      */

      allow delete:
        if admin();
    }


    /* =====================================================
       DRIVERS
       Kept for compatibility with older RiderX data.
    ===================================================== */

    match /drivers/{uid} {

      allow read:
        if loggedIn();


      allow create, update:
        if isOwner(uid)
        || admin();


      allow delete:
        if admin();
    }


    /* =====================================================
       RIDES
    ===================================================== */

    match /rides/{rideId} {

      /*
        Customer can create own ride.
      */

      allow create:
        if loggedIn()
        && request.resource.data.customerId
           == request.auth.uid;


      /*
        Logged-in users can read rides.
        Admin has full access.
      */

      allow read:
        if loggedIn();


      /*
        Customer can update own ride.
        Assigned rider can update ride.
        Admin can update anything.
      */

      allow update:
        if loggedIn()
        && (

          resource.data.customerId
            == request.auth.uid

          ||

          resource.data.riderId
            == request.auth.uid

          ||

          resource.data.driverId
            == request.auth.uid

          ||

          request.resource.data.riderId
            == request.auth.uid

          ||

          request.resource.data.driverId
            == request.auth.uid

          ||

          admin()

        );


      /*
        Only admin can delete rides.
      */

      allow delete:
        if admin();
    }


    /* =====================================================
       CHATS
    ===================================================== */

    match /chats/{chatId} {

      allow read, write:
        if loggedIn();
    }


    /* =====================================================
       WALLETS
    ===================================================== */

    match /wallets/{uid} {

      /*
        Owner can read own wallet.
        Admin can read all wallets.
      */

      allow read:
        if isOwner(uid)
        || admin();


      /*
        Only admin can directly modify wallets.
      */

      allow write:
        if admin();
    }


    /* =====================================================
       NOTIFICATIONS
    ===================================================== */

    match /notifications/{uid}/items/{id} {

      /*
        Owner can read notifications.
      */

      allow read:
        if isOwner(uid)
        || admin();


      /*
        Logged-in system/users can create notifications.
        Admin has full access.
      */

      allow create, update:
        if loggedIn();


      allow delete:
        if isOwner(uid)
        || admin();
    }


    /* =====================================================
       SETTINGS
    ===================================================== */

    match /settings/{id} {

      /*
        Logged-in users can read settings.
      */

      allow read:
        if loggedIn();


      /*
        Only admin can change settings.
      */

      allow create, update, delete:
        if admin();
    }


    /* =====================================================
       ADMIN / APP CONFIG
    ===================================================== */

    match /admin/{id} {

      allow read:
        if admin();


      allow write:
        if admin();
    }


    /* =====================================================
       FARE / PRICING
    ===================================================== */

    match /pricing/{id} {

      allow read:
        if loggedIn();


      allow write:
        if admin();
    }


    match /fareSettings/{id} {

      allow read:
        if loggedIn();


      allow write:
        if admin();
    }


    /* =====================================================
       COMMISSION
    ===================================================== */

    match /commission/{id} {

      allow read:
        if loggedIn();


      allow write:
        if admin();
    }


    /* =====================================================
       COUPONS
    ===================================================== */

    match /coupons/{id} {

      allow read:
        if loggedIn();


      allow create, update, delete:
        if admin();
    }


    /* =====================================================
       OFFERS
    ===================================================== */

    match /offers/{id} {

      allow read:
        if loggedIn();


      allow create, update, delete:
        if admin();
    }


    /* =====================================================
       SUPPORT
    ===================================================== */

    match /supports/{id} {

      allow create:
        if loggedIn();


      allow read:
        if loggedIn();


      allow update, delete:
        if admin();
    }


    /* =====================================================
       PAYMENTS
    ===================================================== */

    match /payments/{paymentId} {

      allow read:
        if loggedIn();


      allow create:
        if loggedIn();


      allow update, delete:
        if admin();
    }


    /* =====================================================
       REPORTS
    ===================================================== */

    match /reports/{id} {

      allow read:
        if admin();


      allow write:
        if admin();
    }

  }
}
